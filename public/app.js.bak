const $=id=>document.getElementById(id);
const BACKEND_URL=(window.ZENTO_CONFIG?.API_URL||window.location.origin||'').replace(/\/$/,'');
const backendUrl=p=>/^https?:\/\//i.test(p||'')?p:BACKEND_URL+(p?.startsWith('/')?p:'/'+(p||''));
let token=localStorage.getItem('zento_token'),me=null,convs=[],current=null,socket=null,replyTo=null,activeFilter='all',searchTimer=null,settings={},adminConversation=null,call=null;
// Stage 2 multi-select state must exist before any message handler can read it.
let selectedStage2Messages=[];
const emojis=['😀','😃','😄','😁','😆','😅','😂','🤣','😊','😇','🙂','🙃','😉','😌','😍','🥰','😘','😎','🤩','🥳','🤔','🤭','🤫','🫡','😴','😮','😲','😢','😭','😡','🤬','🤯','😱','😶','🙄','😏','🤗','🫠','👍','👎','👏','🙌','🙏','💪','🤝','✌️','👌','❤️','🧡','💛','💚','💙','💜','🖤','🤍','🤎','💔','🔥','✨','⭐','🌟','💯','🎉','🎊','🚀','🎯','💡','📌','📢','👥','💬','🎙️','🎵','🎬','📎','🌈','☀️','🌙','🍕','🍔','🍰','☕','⚽','🏀','🎮','🎧','🎸','🐱','🐶','🦊','🐼','🌹','🎁','💎','🧠','⚡','💫','🫶','👀'];
const esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
function formatText(value){const text=esc(value).replace(/\r?\n/g,'<br>');const linked=text.replace(/(^|[\s(])((?:https?:\/\/|www\.)[^\s<]+)/gi,(m,p,u)=>`${p}<a class="text-link" href="${u.startsWith('www.')?'https://'+u:u}" target="_blank" rel="noopener noreferrer">${u}</a>`);return linked.replace(/(^|[\s>])@([a-zA-Z0-9_]{3,32})\b/g,(m,p,u)=>`${p}<button type="button" class="mention" data-username="${u}">@${u}</button>`)}
const avatar=(u,cls='avatar')=>u?.avatar?`<div class="${cls}"><img src="${esc(backendUrl(u.avatar))}"></div>`:`<div class="${cls}">${esc((u?.display_name||'گ')[0])}</div>`;
const CALL_ICE=[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun1.l.google.com:19302'}];
function showToast(msg,error=false){const t=$('toast');t.textContent=msg;t.className='toast show'+(error?' error':'');clearTimeout(showToast.t);showToast.t=setTimeout(()=>t.className='toast',4200)}
window.addEventListener('error',e=>{if(e?.error?.message)showToast(e.error.message,true)});
function api(url,opt={}){opt.headers={...(opt.headers||{}),...(token?{Authorization:'Bearer '+token}:{})};if(opt.body&&!(opt.body instanceof FormData))opt.headers['Content-Type']='application/json';return fetch(backendUrl(url),opt).then(async r=>{const ct=r.headers.get('content-type')||'';const d=ct.includes('application/json')?await r.json().catch(()=>({})):{};if(!r.ok)throw Error(d.error||`خطا (${r.status})`);return d})}
function showAuth(){$('auth').classList.remove('hidden');$('app').classList.add('hidden')}function showApp(){$('auth').classList.add('hidden');$('app').classList.remove('hidden')}
function closeDrawer(){$('drawer').classList.remove('open');$('drawerShade').classList.add('hidden');$('sidebar').classList.remove('open')}
function openDrawer(){$('drawer').classList.add('open');$('drawerShade').classList.remove('hidden')}
async function boot(){
 if(!token)return showAuth();
 try{me=await api('/api/me');showApp();refreshUserUI();await loadSettings();connectSocket();await loadConvs();}catch(e){localStorage.removeItem('zento_token');token=null;showAuth();showToast(e.message,true)}
}
function connectSocket(){
 socket=io(BACKEND_URL||undefined,{auth:{token},transports:['polling'],upgrade:false,reconnection:true,reconnectionAttempts:Infinity,reconnectionDelay:1000,reconnectionDelayMax:5000});
 socket.on('connect_error',e=>console.warn('socket',e.message));
 socket.on('message',m=>{if(current&&Number(m.conversation_id)===Number(current.id))appendMessage(m);loadConvs().catch(()=>{})});
 socket.on('reaction',d=>{const el=document.querySelector(`[data-msg="${d.messageId}"]`);if(el)renderReactions(el,d.reactions)});
 socket.on('message_deleted',id=>{document.querySelector(`[data-msg="${id}"]`)?.remove()});
 socket.on('read_receipt',d=>{if(current&&Number(d.conversationId)===Number(current.id))document.querySelectorAll('.mine .msg-status').forEach(x=>{x.textContent='✓✓';x.classList.add('read')})});
 socket.on('member_removed',d=>{if(current&&Number(current.id)===Number(d.conversationId)&&Number(d.userId)===Number(me.id)){showToast('از این گفتگو حذف شدید',true);current=null;loadConvs();$('messages').innerHTML='<div class="empty"><b>عضویت شما پایان یافت</b></div>'}});
 socket.on('typing',d=>{if(current)$('typing').textContent=d.typing?'در حال نوشتن…':''});
 installCallHandlers();
}
async function loadSettings(){try{settings=await api('/api/settings')}catch{settings={notifications:{messages:true,sounds:true,previews:true},data_usage:{autoplay:true,autoDownloadImages:true,autoDownloadVideos:false,autoDownloadAudio:false},privacy:{lastSeen:'everyone',profilePhoto:'everyone',readReceipts:true},security:{twoStep:false}}}}
async function loadConvs(){convs=await api('/api/conversations');renderConvs();await handleJoinHash()}
async function handleJoinHash(){const m=location.hash.match(/^#\/join\/([^/]+)$/);if(!m)return;try{const info=await api('/api/public/conversations/'+encodeURIComponent(m[1]));const c=await api('/api/conversations/'+info.id+'/join',{method:'POST'});await loadConvs();openConv(c.id);history.replaceState(null,'',location.pathname+location.search)}catch(e){showToast(e.message,true)}}
async function stage2HandleMessageHash(){
  if(!token)return;
  const m=location.hash.match(/^#\/msg\/(\d+)\/(\d+)$/); if(!m)return;
  const cid=Number(m[1]), mid=Number(m[2]);
  try{
    if(!convs.length) await loadConvs();
    if(!convs.some(c=>Number(c.id)===cid)) return showToast('این گفتگو برای حساب شما در دسترس نیست',true);
    await openConv(cid);
    setTimeout(()=>{
      const row=document.querySelector(`[data-msg="${mid}"]`);
      if(row){row.scrollIntoView({behavior:'smooth',block:'center'});row.classList.add('stage2-highlight');setTimeout(()=>row.classList.remove('stage2-highlight'),1800)}
      else showToast('پیام پیدا نشد یا حذف شده است',true);
    },120);
  }catch(e){showToast(e.message,true)}
}
window.addEventListener('hashchange',handleJoinHash);
window.addEventListener('hashchange',stage2HandleMessageHash)
function renderConvs(){const list=activeFilter==='all'?convs:convs.filter(c=>c.type===activeFilter);$('chats').innerHTML=list.map(c=>{const other=c.type==='direct'?c.members.find(x=>Number(x.id)!==Number(me.id)):null;const title=c.type==='direct'?(other?.display_name||'گفتگو'):c.name;const icon=c.type==='channel'?'📢':c.type==='group'?'👥':'گ';return `<button class="chat-item ${current&&Number(current.id)===Number(c.id)?'active':''}" data-id="${c.id}">${c.type==='direct'?avatar(other):`<div class="avatar">${icon}</div>`}<div class="ci"><b>${esc(title)}</b><small>${c.type==='channel'?'کانال':c.type==='group'?`${c.members.length} عضو`:'@'+esc(other?.username||'')} · ${esc(c.last_text||'')}</small></div><span class="type-badge">${c.unread_count>0?`<b class="unread-badge">${c.unread_count>99?'99+':c.unread_count}</b>`:''}${c.type==='channel'?'کانال':c.type==='group'?'گروه':'خصوصی'}</span></button>`}).join('')||'<div class="empty"><span>گفتگویی پیدا نشد</span></div>'}
$('chats').onclick=e=>{const x=e.target.closest('.chat-item');if(x)openConv(Number(x.dataset.id))};
async function openConv(id){const found=convs.find(c=>Number(c.id)===Number(id));if(!found)return;current=found;renderConvs();if(socket?.connected)socket.emit('join',current.id);const other=current.type==='direct'?current.members.find(x=>Number(x.id)!==Number(me.id)):null;$('chatAvatar').outerHTML=`<div id="chatAvatar" class="avatar">${current.type==='direct'?(other?.avatar?`<img src="${esc(backendUrl(other.avatar))}">`:esc((other?.display_name||'گ')[0])):(current.type==='channel'?'📢':'👥')}</div>`;$('chatTitle').textContent=current.type==='direct'?(other?.display_name||'گفتگو'):current.name;$('chatStatus').textContent=current.type==='channel'?`📢 ${current.members.length} عضو`:current.type==='group'?`👥 ${current.members.length} عضو`:`@${other?.username||''}`;document.querySelector('#chatAvatar')?.addEventListener('click',()=>current.type==='direct'&&other?openUserProfile(other.id):openConversationInfo(current));$('chatTitle').onclick=current.type==='direct'&&other?()=>openUserProfile(other.id):(current.type==='group'||current.type==='channel'?()=>openConversationInfo(current):null);const can=current.type!=='channel'||Number(current.owner_id)===Number(me.id);$('text').disabled=!can;$('send').disabled=!can;$('voice').disabled=!can;$('text').placeholder=can?'پیامی بنویس...':'این کانال فقط برای مشاهده است';$('messages').innerHTML='<div class="empty">در حال بارگذاری…</div>';try{const ms=await api(`/api/conversations/${id}/messages`);$('messages').innerHTML='';try{await api(`/api/conversations/${id}/read`,{method:'POST'});found.unread_count=0;renderConvs()}catch{}if(!ms.length)$('messages').innerHTML='<div class="empty"><b>شروع گفتگو</b><span>اولین پیام را بفرست 👋</span></div>';ms.forEach(appendMessage);scrollBottom();if(innerWidth<851)$('sidebar').classList.remove('open')}catch(e){$('messages').innerHTML=`<div class="empty"><b>خطا در باز کردن گفتگو</b><span>${esc(e.message)}</span></div>`}}
function appendMessage(m){if(!current||Number(m.conversation_id)!==Number(current.id)||document.querySelector(`[data-msg="${m.id}"]`))return;const row=document.createElement('div');const mine=Number(m.sender_id)===Number(me.id);row.className='bubble-row '+(mine?'mine':'');row.dataset.msg=m.id;const sender=m.bot_name||m.display_name||m.username||'کاربر';let body='';if(m.reply_to)body+=`<div class="reply-ref">↩ پاسخ به: ${esc(m.text||'پیام چندرسانه‌ای')}</div>`;if(m.kind==='voice')body+=mediaAudio(m.file_url,true,m.file_name,m.id);else if(m.file_url&&m.file_type?.startsWith('image/'))body+=`<div class="media-card"><img src="${esc(backendUrl(m.file_url))}" class="image-open"><a class="download-btn" download href="${esc(backendUrl('/api/media/download/'+m.id))}">دانلود تصویر ⬇</a></div>`;else if(m.file_url&&m.file_type?.startsWith('video/'))body+=`<div class="media-card"><video controls playsinline preload="metadata" src="${esc(backendUrl(m.file_url))}"></video><a class="download-btn" download href="${esc(backendUrl('/api/media/download/'+m.id))}">دانلود ویدیو ⬇</a></div>`;else if(m.file_url&&m.file_type?.startsWith('audio/'))body+=mediaAudio(m.file_url,false,m.file_name,m.id);else if(m.file_url)body+=`<div class="file-card"><span>📎</span><div class="file-name">${esc(m.file_name||'فایل')}</div><a class="download-btn" download href="${esc(backendUrl('/api/media/download/'+m.id))}">دانلود ⬇</a></div>`;if(m.kind==='gif')body+=`<div class="media-card"><img src="${esc(backendUrl(m.file_url))}"><a class="download-btn" download href="${esc(backendUrl('/api/media/download/'+m.id))}">دانلود GIF ⬇</a></div>`;if(m.kind==='sticker')body+=`<div class="media-card"><img src="${esc(backendUrl(m.file_url))}" style="max-width:180px;max-height:180px"><a class="download-btn" download href="${esc(backendUrl('/api/media/download/'+m.id))}">ذخیره استیکر ⬇</a></div>`;if(Array.isArray(m.quote_ids)&&m.quote_ids.length)body+=`<div class="quote-block">💬 نقل قول ${m.quote_ids.length} پیام</div>`;if(m.text)body+=`<div class="body-text">${formatText(m.text)}</div>`;if(m.expires_at)body+=`<small class="expiry-note">⏱️ ناپدیدشونده</small>`;const actions=`<div class="msg-actions"><button data-act="reply">↩ پاسخ</button><button data-act="select">☑ انتخاب</button><button data-act="link">🔗 لینک</button><button data-act="forward">↪ فوروارد</button><button data-act="save">🔖 ذخیره</button>${mine?'<button data-act="delete">🗑 حذف</button>':''}<button data-act="react">❤️</button></div>`;row.innerHTML=`${!mine?avatar({display_name:sender,avatar:m.avatar},'avatar mini-avatar'):''}<div class="bubble"><div class="meta">${!mine?`<button class="sender-name">${esc(sender)}</button>`:''}<span>${new Date(m.created_at).toLocaleTimeString('fa-IR',{hour:'2-digit',minute:'2-digit'})}</span>${mine?`<span class="msg-status">✓</span>`:''}</div>${body}${actions}<div class="reactions"></div></div>`;$('messages').appendChild(row);messageCache[m.id]=m;renderReactions(row,m.reactions);bindMessageRow(row);}
function mediaAudio(url,voice,name,id){return `<div class="media-card"><audio controls preload="metadata" src="${esc(backendUrl(url))}"></audio><div class="file-card"><span>${voice?'🎙️':'🎵'}</span><div class="file-name">${esc(voice?'پیام صوتی':name||'آهنگ')}</div><a class="download-btn" href="${esc(backendUrl('/api/media/download/'+id))}" target="_blank">دانلود ⬇</a></div></div>`}
function bindMessageRow(row){row.querySelector('[data-act="reply"]')?.addEventListener('click',()=>{const mId=Number(row.dataset.msg);replyTo=mId;$('replyPreview').textContent=row.querySelector('.body-text')?.textContent||'پیام چندرسانه‌ای';$('replyBar').classList.remove('hidden');$('text').focus()});row.querySelector('[data-act="save"]')?.addEventListener('click',async()=>{try{const r=await api('/api/saved/'+row.dataset.msg,{method:'POST'});showToast(r.saved?'پیام ذخیره شد':'از ذخیره‌شده‌ها حذف شد')}catch(e){showToast(e.message,true)}});row.querySelector('[data-act="delete"]')?.addEventListener('click',()=>{if(socket?.connected)socket.emit('delete_message',Number(row.dataset.msg))});row.querySelector('[data-act="link"]')?.addEventListener('click',async()=>{try{const r=await api('/api/messages/'+row.dataset.msg+'/link');await navigator.clipboard.writeText(r.url);showToast('لینک پیام کپی شد')}catch(e){showToast(e.message,true)}});
row.querySelector('[data-act="forward"]')?.addEventListener('click',async()=>{const cid=prompt('شناسه گفتگو مقصد را وارد کنید:');if(!cid)return;try{await api('/api/messages/'+row.dataset.msg+'/forward',{method:'POST',body:JSON.stringify({conversationId:Number(cid)})});showToast('پیام فوروارد شد')}catch(e){showToast(e.message,true)}});
row.querySelector('[data-act="select"]')?.addEventListener('click',()=>{row.classList.toggle('selected');selectedStage2Messages??=[];const id=Number(row.dataset.msg);selectedStage2Messages=selectedStage2Messages.includes(id)?selectedStage2Messages.filter(x=>x!==id):[...selectedStage2Messages,id];showToast(`تعداد انتخاب: ${selectedStage2Messages.length}`)});
row.querySelector('[data-act="react"]')?.addEventListener('click',()=>{const em=promptEmoji();if(em)socket.emit('react',{messageId:Number(row.dataset.msg),emoji:em})});row.querySelector('.sender-name')?.addEventListener('click',()=>{const m=messageCache[Number(row.dataset.msg)];if(m?.sender_id)openUserProfile(m.sender_id)});row.querySelector('.mini-avatar')?.addEventListener('click',()=>{const m=messageCache[Number(row.dataset.msg)];if(m?.sender_id)openUserProfile(m.sender_id)});row.querySelector('.image-open')?.addEventListener('click',e=>{$('lightboxImg').src=e.target.src;$('lightbox').classList.remove('hidden')})}
const messageCache=new Proxy({},{});function promptEmoji(){return '❤️'}function renderReactions(row,reactions={}){const r=row.querySelector('.reactions');r.innerHTML=Object.entries(reactions||{}).map(([e,a])=>`<button class="reaction">${e} ${a.length}</button>`).join('')}
function scrollBottom(){const m=$('messages');m.scrollTop=m.scrollHeight}
$('composer').onsubmit=async e=>{e.preventDefault();if(!current)return;const text=$('text').value.trim();if(!text)return;try{const out=await api('/api/messages',{method:'POST',body:JSON.stringify({conversationId:current.id,text,replyTo})});$('text').value='';replyTo=null;selectedStage2Messages=[];document.querySelectorAll('.bubble-row.selected').forEach(x=>x.classList.remove('selected'));$('replyBar').classList.add('hidden');appendMessage(out);scrollBottom();if(socket?.connected)socket.emit('typing',{conversationId:current.id,typing:false})}catch(err){showToast(err.message,true)}};
$('text').oninput=()=>{if(!current||!socket?.connected)return;socket.emit('typing',{conversationId:current.id,typing:true});clearTimeout(window.tt);window.tt=setTimeout(()=>socket.emit('typing',{conversationId:current.id,typing:false}),900)};
$('cancelReply').onclick=()=>{replyTo=null;$('replyBar').classList.add('hidden')};
$('attach').onclick=()=>$('file').click();$('file').onchange=async()=>{const f=$('file').files[0];if(!f||!current)return;try{showToast('در حال آپلود فایل…');const fd=new FormData();fd.append('file',f);const u=await api('/api/upload',{method:'POST',body:fd});const kind=f.type==='image/gif'?'gif':f.type.startsWith('image/')?'image':f.type.startsWith('video/')?'video':f.type.startsWith('audio/')?'audio':'file';const out=await api('/api/messages',{method:'POST',body:JSON.stringify({conversationId:current.id,text:'',fileUrl:u.url,fileType:u.mime,fileName:u.name,kind})});appendMessage(out);scrollBottom();$('file').value=''}catch(e){showToast(e.message,true)}};
$('voice').onclick=async()=>{if(!current)return;if(!navigator.mediaDevices?.getUserMedia)return showToast('ضبط صدا در این مرورگر پشتیبانی نمی‌شود',true);if(window._rec?.state==='recording'){window._rec.stop();return}try{const stream=await navigator.mediaDevices.getUserMedia({audio:true});const rec=new MediaRecorder(stream);const chunks=[];rec.ondataavailable=e=>chunks.push(e.data);rec.onstop=async()=>{stream.getTracks().forEach(t=>t.stop());const blob=new Blob(chunks,{type:rec.mimeType||'audio/webm'});const fd=new FormData();fd.append('file',blob,'voice.webm');try{const u=await api('/api/upload',{method:'POST',body:fd});const out=await api('/api/messages',{method:'POST',body:JSON.stringify({conversationId:current.id,fileUrl:u.url,fileType:u.mime,fileName:'voice.webm',kind:'voice'})});appendMessage(out);scrollBottom()}catch(e){showToast(e.message,true)}};window._rec=rec;rec.start();showToast('ضبط پیام صوتی شروع شد؛ برای توقف دوباره 🎙 را بزن')}catch(e){showToast('اجازه دسترسی به میکروفون داده نشد',true)}};
$('emoji').onclick=()=>{$('emojiPanel').classList.toggle('hidden');renderMediaTab('emoji')};document.querySelectorAll('[data-media-tab]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-media-tab]').forEach(x=>x.classList.remove('active'));b.classList.add('active');renderMediaTab(b.dataset.mediaTab)});
function renderMediaTab(tab){const body=$('emojiBody');if(tab==='emoji'){body.innerHTML='<div class="emoji-grid">'+emojis.map(e=>`<button>${e}</button>`).join('')+'</div>';body.querySelectorAll('button').forEach(b=>b.onclick=()=>{$('text').value+=b.textContent;$('text').focus()})}else if(tab==='gif'){body.innerHTML=`<div class="media-picker"><div><b>GIF</b><p>GIF آماده را بفرست یا از یک ویدیو GIF کوتاه بساز.</p><input id="gifUpload" type="file" accept="image/gif,video/*" hidden><button class="primary" onclick="$('gifUpload').click()">انتخاب GIF / ویدیو</button><div id="gifProgress" style="margin-top:10px;font-size:10px"></div></div></div>`;$('gifUpload').onchange=()=>{const f=$('gifUpload').files[0];if(!f)return;if(f.type==='image/gif')uploadSpecial(f,'gif');else createGifFromVideo(f)}}else{body.innerHTML=`<div class="media-picker"><div><b>استیکر</b><p>یک PNG یا WEBP را به استیکر تبدیل کن و ارسال کن.</p><input id="stickerUpload" type="file" accept="image/png,image/webp,image/jpeg" hidden><button class="primary" onclick="$('stickerUpload').click()">ساخت / آپلود استیکر</button></div></div>`;$('stickerUpload').onchange=()=>uploadSpecial($('stickerUpload').files[0],'sticker')}}
async function uploadSpecial(file,kind){if(!file||!current)return;try{const fd=new FormData();fd.append('file',file,kind==='sticker'?'sticker.webp':'animation.gif');const u=await api('/api/upload',{method:'POST',body:fd});const out=await api('/api/messages',{method:'POST',body:JSON.stringify({conversationId:current.id,fileUrl:u.url,fileType:u.mime,fileName:u.name,kind})});appendMessage(out);$('emojiPanel').classList.add('hidden');scrollBottom()}catch(e){showToast(e.message,true)}}
async function createGifFromVideo(file){if(!current)return;const progress=$('gifProgress');try{if(!window.GIF)throw Error('ابزار ساخت GIF بارگذاری نشد؛ یک GIF آماده انتخاب کن');progress.textContent='در حال ساخت GIF…';const url=URL.createObjectURL(file),v=document.createElement('video');v.src=url;v.muted=true;v.playsInline=true;await new Promise((res,rej)=>{v.onloadedmetadata=res;v.onerror=rej});const maxW=420,scale=Math.min(1,maxW/v.videoWidth),w=Math.max(2,Math.round(v.videoWidth*scale)),h=Math.max(2,Math.round(v.videoHeight*scale));const canvas=document.createElement('canvas');canvas.width=w;canvas.height=h;const ctx=canvas.getContext('2d');const gif=new GIF({workers:2,quality:12,width:w,height:h,workerScript:'https://cdn.jsdelivr.net/npm/gif.js@0.2.0/dist/gif.worker.js'});const duration=Math.min(v.duration,6),frames=Math.max(8,Math.floor(duration*8));for(let i=0;i<frames;i++){const target=duration*i/frames;if(target>0){await new Promise(r=>{const f=()=>{v.removeEventListener('seeked',f);r()};v.addEventListener('seeked',f);v.currentTime=target})}else v.currentTime=0;ctx.drawImage(v,0,0,w,h);gif.addFrame(ctx,{copy:true,delay:125});progress.textContent=`در حال ساخت ${i+1}/${frames}`;}gif.on('finished',blob=>{URL.revokeObjectURL(url);uploadSpecial(new File([blob],'animation.gif',{type:'image/gif'}),'gif')});gif.render()}catch(e){showToast(e.message||'ساخت GIF ناموفق بود',true);if(progress)progress.textContent=''}}
async function stage2SearchDialog(){
  if(!current)return showToast('اول یک گفتگو را انتخاب کن',true);
  openModal('🔎 جستجو در گفتگو',`<div class="s2-search"><input id="s2q" placeholder="جستجو در گفتگو..." autofocus><div class="s2-filters"><select id="s2type"><option value="all">همه</option><option value="image">📷 عکس</option><option value="video">🎥 ویدیو</option><option value="audio">🎵 صوت</option><option value="file">📄 فایل</option><option value="link">🔗 لینک</option></select><input id="s2from" type="date"><input id="s2to" type="date"><button id="s2go" class="primary">جستجو</button></div><div id="s2results" class="s2-results"><div class="empty">عبارت جستجو را وارد کن.</div></div></div>`,()=>{});
  $('modalOk').classList.add('hidden');$('modalCancel').textContent='بستن';
  const run=async()=>{const qv=$('s2q').value.trim();const params=new URLSearchParams({q:qv,type:$('s2type').value});if($('s2from').value)params.set('from',$('s2from').value);if($('s2to').value){const d=new Date($('s2to').value);d.setDate(d.getDate()+1);params.set('to',d.toISOString())}try{const r=await api(`/api/conversations/${current.id}/search?${params}`);$('s2results').innerHTML=r.length?r.map(m=>`<button class="search-result" data-s2msg="${m.id}"><b>${esc(m.display_name||m.username||'کاربر')}</b><small>${esc(new Date(m.created_at).toLocaleString('fa-IR'))}</small><div>${m.text?formatText(m.text):esc(m.kind==='voice'?'🎙️ پیام صوتی':m.file_name||'📎 فایل')}</div></button>`).join(''):'<div class="empty">نتیجه‌ای پیدا نشد.</div>';document.querySelectorAll('[data-s2msg]').forEach(x=>x.onclick=()=>{const id=Number(x.dataset.s2msg);$('modal').classList.add('hidden');const row=document.querySelector(`[data-msg="${id}"]`);if(row){row.scrollIntoView({behavior:'smooth',block:'center'});row.classList.add('stage2-highlight');setTimeout(()=>row.classList.remove('stage2-highlight'),1800)}else showToast('پیام پیدا شد؛ برای نمایش آن گفتگو را باز کن')})}catch(e){$('s2results').innerHTML=`<div class="empty"><b>خطا</b><span>${esc(e.message)}</span></div>`}};
  $('s2go').onclick=run;$('s2q').onkeydown=e=>{if(e.key==='Enter')run()};
}

$('newChatMenu').onclick=()=>newMenu();$('menuBtn').onclick=openDrawer;$('mobileMenu').onclick=()=>{$('sidebar').classList.toggle('open')};$('drawerShade').onclick=closeDrawer;$('theme').onclick=toggleTheme;$('drawerTheme').onclick=toggleTheme;$('logout').onclick=$('drawerLogout').onclick=logout;$('drawerProfile').onclick=()=>{closeDrawer();openProfile()};$('drawerNewGroup').onclick=()=>{closeDrawer();newGroup()};$('drawerNewChannel').onclick=()=>{closeDrawer();newChannel()};$('drawerSaved').onclick=$('drawerSavedSide').onclick=()=>{closeDrawer();openSaved()};$('drawerSettings').onclick=()=>{closeDrawer();openSettings()};$('chatMore').onclick=()=>{if(current&&(current.type==='group'||current.type==='channel'))openAdmin(current)};$('chatSearch').onclick=stage2SearchDialog;
function toggleTheme(){document.body.classList.toggle('dark');localStorage.setItem('zento_theme',document.body.classList.contains('dark')?'dark':'light');$('themeState').textContent=document.body.classList.contains('dark')?'روشن':'خاموش'}if(localStorage.getItem('zento_theme')==='dark')toggleTheme();
function newMenu(){openModal('گفتگوی جدید',`<div class="modal-choice"><button data-choice="direct">👤 گفتگوی خصوصی</button><button data-choice="group">👥 گروه جدید</button><button data-choice="channel">📢 کانال جدید</button></div>`,()=>{});document.querySelectorAll('[data-choice]').forEach(b=>b.onclick=()=>{closeModal();b.dataset.choice==='direct'?searchFocus():b.dataset.choice==='group'?newGroup():newChannel()})}
function searchFocus(){$('search').focus();showToast('نام کاربر را جستجو کن و روی آن بزن')}
async function newGroup(){const users=await api('/api/users');openModal('گروه جدید',`<label>نام گروه<input id="newName" placeholder="مثلاً دوستان دانشگاه"></label><label>شناسه عمومی<input id="newUsername" placeholder="my_group"></label><label>توضیحات<input id="newDesc" placeholder="توضیحات اختیاری"></label><div class="pick-users">${users.map(u=>`<label class="pick"><input type="checkbox" value="${u.id}">${esc(u.display_name)} <small>@${esc(u.username)}</small></label>`).join('')}</div>`,async()=>{const members=[...document.querySelectorAll('.pick input:checked')].map(x=>Number(x.value));const c=await api('/api/conversations/group',{method:'POST',body:JSON.stringify({name:$('newName').value,username:$('newUsername').value,description:$('newDesc').value,members})});closeModal();await loadConvs();openConv(c.id)})}
async function newChannel(){openModal('کانال جدید',`<label>نام کانال<input id="newName" placeholder="کانال زنتو"></label><label>شناسه عمومی<input id="newUsername" placeholder="zento_news"></label><label>توضیحات<input id="newDesc" placeholder="توضیحات"></label>`,async()=>{const c=await api('/api/conversations/channel',{method:'POST',body:JSON.stringify({name:$('newName').value,username:$('newUsername').value,description:$('newDesc').value})});closeModal();await loadConvs();openConv(c.id)})}
function openModal(title,body,onOk){$('modalTitle').textContent=title;$('modalBody').innerHTML=body;$('modal').classList.remove('hidden');$('modalOk').onclick=async()=>{try{await onOk()}catch(e){showToast(e.message,true)}};$('modalOk').textContent='تأیید'}function closeModal(){$('modal').classList.add('hidden')}$('modalX').onclick=$('modalCancel').onclick=closeModal;
async function openProfile(){const u=me;$('profileUser').textContent='@'+u.username;$('profileName').value=u.display_name;$('profileUsername').value=u.username||'';$('profileBio').value=u.bio||'';$('profileAvatarBtn').innerHTML=u.avatar?`<img src="${esc(backendUrl(u.avatar))}">`:esc((u.display_name||'گ')[0]);$('profileModal').classList.remove('hidden')}$('closeProfile').onclick=()=>$('profileModal').classList.add('hidden');$('profileAvatarBtn').onclick=()=>$('avatarFile').click();$('avatarFile').onchange=async()=>{const f=$('avatarFile').files[0];if(!f)return;const fd=new FormData();fd.append('avatar',f);try{me=await api('/api/profile/avatar',{method:'POST',body:fd});refreshUserUI();openProfile();showToast('عکس پروفایل ذخیره شد')}catch(e){showToast(e.message,true)}};$('saveProfile').onclick=async()=>{try{me=await api('/api/profile',{method:'PUT',body:JSON.stringify({displayName:$('profileName').value,bio:$('profileBio').value,username:$('profileUsername')?.value})});refreshUserUI();$('profileModal').classList.add('hidden');showToast('پروفایل ذخیره شد')}catch(e){showToast(e.message,true)}};
function refreshUserUI(){const first=(me.display_name||'گ')[0];$('drawerAvatar').innerHTML=me.avatar?`<img src="${esc(backendUrl(me.avatar))}">`:first;$('drawerName').textContent=me.display_name;$('drawerUser').textContent='@'+me.username}
async function openConversationInfo(c){try{const fresh=await api('/api/conversations/'+c.id+'/messages').then(()=>c).catch(()=>c);const link=c.username?`${location.origin}/#/join/${encodeURIComponent(c.username)}`:'';openModal(c.type==='channel'?'اطلاعات کانال':'اطلاعات گروه',`<div class="profile-preview"><div class="avatar huge">${c.type==='channel'?'📢':'👥'}</div><div><b>${esc(c.name)}</b><small>${c.type==='channel'?'کانال':'گروه'} · ${c.members.length} عضو</small></div></div><div class="profile-line"><span>📝</span><div>${esc(c.description||'توضیحی ثبت نشده')}</div></div>${c.username?`<div class="profile-line"><span>🔗</span><div dir="ltr">@${esc(c.username)}<br><small>${esc(link)}</small></div></div>`:''}<div class="profile-actions">${c.username?`<button id="copyConvLink" class="primary">کپی لینک دعوت</button>`:''}</div>`,async()=>{});$('modalOk').classList.add('hidden');$('modalCancel').textContent='بستن';$('copyConvLink')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(link);showToast('لینک کپی شد')}catch{showToast(link)}})}catch(e){showToast(e.message,true)}}
async function openUserProfile(id){try{const u=await api('/api/users/'+id+'/profile');openModal('پروفایل کاربر',`<div class="profile-preview">${avatar(u,'avatar huge')}<div><b>${esc(u.display_name)}</b><small>@${esc(u.username)}</small></div></div><div class="profile-line"><span>📝</span><div>${esc(u.bio||'بیویی ثبت نشده')}</div></div><div class="profile-actions"><button id="startDirect" class="primary">💬 پیام</button><button id="blockOther" class="danger">${u.blocked?'🔓 رفع بلاک':'🚫 بلاک'}</button></div>`,async()=>{});$('modalOk').classList.add('hidden');$('modalCancel').textContent='بستن';document.querySelector('#modalBody .avatar.huge img')?.addEventListener('click',e=>{$('lightboxImg').src=e.target.src;$('lightbox').classList.remove('hidden')});$('startDirect').onclick=async()=>{try{const c=await api('/api/conversations/direct',{method:'POST',body:JSON.stringify({userId:id})});closeModal();await loadConvs();openConv(c.id)}catch(e){showToast(e.message,true)}};$('blockOther').onclick=async()=>{try{const r=await api('/api/users/'+id+'/block',{method:'POST'});$('blockOther').textContent=r.blocked?'🔓 رفع بلاک':'🚫 بلاک';showToast(r.blocked?'کاربر بلاک شد':'بلاک برداشته شد')}catch(e){showToast(e.message,true)}}}catch(e){showToast(e.message,true)}}
async function openSaved(){try{const data=await api('/api/saved/chat');$('savedList').innerHTML='';const personal=data.messages||[];const saved=(data.saved||[]).map(x=>x.message).filter(Boolean);const all=[...personal,...saved].sort((a,b)=>new Date(a.created_at)-new Date(b.created_at));all.forEach(m=>appendSavedMessage(m));$('savedModal').classList.remove('hidden');$('savedSearch').value='';setTimeout(()=>{const x=$('savedList');x.scrollTop=x.scrollHeight},0)}catch(e){showToast(e.message,true)}}
function appendSavedMessage(m){const mine=Number(m.sender_id)===Number(me.id);const row=document.createElement('div');row.className='bubble-row '+(mine?'mine':'');row.dataset.savedMsg=m.id;let body='';if(m.file_url){if(m.file_type?.startsWith('image/'))body+=`<div class="media-card"><img src="${esc(backendUrl(m.file_url))}" class="image-open"><a class="download-btn" download href="${esc(backendUrl('/api/media/download/'+m.id))}">دانلود ⬇</a></div>`;else if(m.file_type?.startsWith('video/'))body+=`<div class="media-card"><video controls playsinline src="${esc(backendUrl(m.file_url))}"></video><a class="download-btn" download href="${esc(backendUrl('/api/media/download/'+m.id))}">دانلود ⬇</a></div>`;else if(m.file_type?.startsWith('audio/')||m.kind==='voice')body+=mediaAudio(m.file_url,m.kind==='voice',m.file_name,m.id);else body+=`<div class="file-card"><span>📎</span><div class="file-name">${esc(m.file_name||'فایل')}</div><a class="download-btn" download href="${esc(backendUrl('/api/media/download/'+m.id))}">دانلود ⬇</a></div>`}if(m.text)body+=`<div class="body-text">${formatText(m.text)}</div>`;row.innerHTML=`<div class="bubble"><div class="meta"><span>${new Date(m.created_at).toLocaleTimeString('fa-IR',{hour:'2-digit',minute:'2-digit'})}</span>${mine?`<span class="msg-status">✓</span>`:''}</div>${body}</div>`;$('savedList').appendChild(row);row.querySelector('.image-open')?.addEventListener('click',e=>{$('lightboxImg').src=e.target.src;$('lightbox').classList.remove('hidden')})}
$('closeSaved').onclick=()=>$('savedModal').classList.add('hidden');
$('savedSearch').oninput=()=>{const q=$('savedSearch').value.trim().toLowerCase();document.querySelectorAll('#savedList .bubble-row').forEach(row=>{row.classList.toggle('hidden',!!q&&!row.textContent.toLowerCase().includes(q))})};
$('savedAttach').onclick=()=>$('savedFile').click();
$('savedFile').onchange=async()=>{const f=$('savedFile').files[0];if(!f)return;try{showToast('در حال آپلود…');const fd=new FormData();fd.append('file',f);const u=await api('/api/upload',{method:'POST',body:fd});const kind=f.type==='image/gif'?'gif':f.type.startsWith('image/')?'image':f.type.startsWith('video/')?'video':f.type.startsWith('audio/')?'audio':'file';const m=await api('/api/saved/chat/messages',{method:'POST',body:JSON.stringify({text:'',fileUrl:u.url,fileType:u.mime,fileName:u.name,kind})});appendSavedMessage(m);$('savedFile').value='';const x=$('savedList');x.scrollTop=x.scrollHeight}catch(e){showToast(e.message,true)}};
$('savedComposer').onsubmit=async e=>{e.preventDefault();const input=$('savedText');const text=input.value.trim();if(!text)return;try{const m=await api('/api/saved/chat/messages',{method:'POST',body:JSON.stringify({text})});appendSavedMessage(m);input.value='';const x=$('savedList');x.scrollTop=x.scrollHeight}catch(err){showToast(err.message,true)}};
async function openSettings(){await loadSettings();renderSettings('notifications');$('settingsModal').classList.remove('hidden')}$('closeSettings').onclick=()=>$('settingsModal').classList.add('hidden');document.querySelectorAll('#settingsNav button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#settingsNav button').forEach(x=>x.classList.remove('active'));b.classList.add('active');renderSettings(b.dataset.section)});
function renderSettings(section){const c=$('settingsContent');const on=(obj,k)=>obj?.[k]!==false;const row=(label,desc,path)=>{const parts=path.split('.'),obj=settings[parts[0]]||{},key=parts[1];return `<div class="setting-row"><div><b>${label}</b><small>${desc}</small></div><button class="switch ${on(obj,key)?'on':''}" data-setting="${path}"></button></div>`};if(section==='notifications')c.innerHTML=`<div class="settings-content"><div class="settings-section"><h4>اعلان‌ها</h4>${row('اعلان پیام‌ها','دریافت اعلان برای پیام‌های جدید','notifications.messages')}${row('صدای اعلان','پخش صدای پیام جدید','notifications.sounds')}${row('نمایش پیش‌نمایش','متن پیام در اعلان نمایش داده شود','notifications.previews')}</div></div>`;else if(section==='data')c.innerHTML=`<div class="settings-content"><h4>داده و رسانه</h4>${row('پخش خودکار','رسانه‌ها خودکار پخش شوند','data_usage.autoplay')}${row('دانلود خودکار عکس','در شبکه‌های معمولی','data_usage.autoDownloadImages')}${row('دانلود خودکار ویدیو','برای کاهش مصرف اینترنت خاموش باشد','data_usage.autoDownloadVideos')}${row('دانلود خودکار صدا','برای کاهش مصرف اینترنت خاموش باشد','data_usage.autoDownloadAudio')}</div>`;else if(section==='privacy')c.innerHTML=`<div class="settings-content"><h4>حریم خصوصی</h4>${row('تیک خوانده‌شدن','وضعیت خوانده‌شدن پیام‌ها','privacy.readReceipts')}<div class="danger-setting"><b>حذف حساب کاربری</b><small>این عملیات دائمی است و قابل بازگشت نیست.</small><button id="deleteAccountBtn" class="danger">حذف حساب</button></div><div class="setting-row"><div><b>آخرین بازدید</b><small>چه کسانی وضعیت آنلاین شما را ببینند</small></div><select class="select-setting" id="lastSeen"><option value="everyone">همه</option><option value="contacts">مخاطبین</option><option value="nobody">هیچ‌کس</option></select></div><div class="setting-row"><div><b>عکس پروفایل</b><small>چه کسانی عکس شما را ببینند</small></div><select class="select-setting" id="profilePhoto"><option value="everyone">همه</option><option value="contacts">مخاطبین</option><option value="nobody">هیچ‌کس</option></select></div></div>`;else if(section==='security')c.innerHTML=`<div class="settings-content"><h4>امنیت</h4>${row('تأیید دومرحله‌ای','پرچم تنظیمات امنیتی حساب','security.twoStep')}<div class="setting-row"><div><b>نشست فعلی</b><small>JWT امن با اعتبار ۷ روزه</small></div><span>✓ فعال</span></div></div>`;else c.innerHTML=`<div class="settings-content"><h4>ظاهر</h4>${row('حالت شب','پوسته تیره','appearance.dark')}${row('نمای فشرده','فاصله کمتر بین پیام‌ها','appearance.compact')}</div>`;if(section==='privacy'){$('deleteAccountBtn')?.addEventListener('click',async()=>{if(!confirm('حذف دائمی حساب؟'))return;try{await api('/api/account',{method:'DELETE'});logout()}catch(e){showToast(e.message,true)}});$('lastSeen').value=settings.privacy?.lastSeen||'everyone';$('profilePhoto').value=settings.privacy?.profilePhoto||'everyone';$('lastSeen').onchange=saveSettingsFromUI;$('profilePhoto').onchange=saveSettingsFromUI}c.querySelectorAll('[data-setting]').forEach(b=>b.onclick=()=>{const [group,key]=b.dataset.setting.split('.');settings[group]??={};settings[group][key]=!b.classList.contains('on');b.classList.toggle('on');saveSettingsFromUI()})}
async function saveSettingsFromUI(){try{if($('lastSeen'))settings.privacy.lastSeen=$('lastSeen').value;if($('profilePhoto'))settings.privacy.profilePhoto=$('profilePhoto').value;await api('/api/settings',{method:'PUT',body:JSON.stringify(settings)});showToast('تنظیمات ذخیره شد')}catch(e){showToast(e.message,true)}}
async function openAdmin(c){adminConversation=c;$('adminSummary').innerHTML=`<b>${esc(c.name)}</b><span>${c.type==='channel'?'کانال':'گروه'} · ${c.members.length} عضو</span>`;$('adminModal').classList.remove('hidden');renderAdminTab('members')}$('closeAdmin').onclick=()=>$('adminModal').classList.add('hidden');document.querySelectorAll('[data-admin-tab]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-admin-tab]').forEach(x=>x.classList.remove('active'));b.classList.add('active');renderAdminTab(b.dataset.adminTab)});
async function renderAdminTab(tab){if(!adminConversation)return;const b=$('adminBody');if(tab==='members'){b.innerHTML=adminConversation.members.map(u=>`<div class="member-row">${avatar(u,'avatar')}<div class="member-main"><b>${esc(u.display_name)}</b><small>@${esc(u.username)}</small></div>${Number(u.id)!==Number(adminConversation.owner_id)?`<div class="member-actions"><button data-promote="${u.id}">👑 ادمین</button><button class="danger" data-kick="${u.id}">حذف</button></div>`:'<small>مالک</small>'}</div>`).join('');b.querySelectorAll('[data-promote]').forEach(x=>x.onclick=()=>promoteAdmin(Number(x.dataset.promote)));b.querySelectorAll('[data-kick]').forEach(x=>x.onclick=()=>kickMember(Number(x.dataset.kick)))}else if(tab==='admins'){const admins=await api('/api/conversations/'+adminConversation.id+'/admins');b.innerHTML=admins.map(a=>`<div class="member-row">${avatar(a,'avatar')}<div class="member-main"><b>${esc(a.display_name)}</b><small>${esc(a.role)} · ${a.permissions?.manage?'مدیریت کامل':''}</small></div>${a.role!=='owner'?`<button class="danger" data-remove-admin="${a.user_id}">حذف ادمین</button>`:''}</div>`).join('')}else b.innerHTML=`<label>نام<input id="adminName" value="${esc(adminConversation.name)}"></label><label>شناسه عمومی<input id="adminUsername" value="${esc(adminConversation.username||'')}" placeholder="my_group"></label><label>توضیحات<input id="adminDesc" value="${esc(adminConversation.description||'')}"></label>${adminConversation.username?`<div class="invite-link">🔗 ${esc(location.origin+'/#/join/'+adminConversation.username)} <button id="copyAdminLink" type="button">کپی</button></div>`:''}<button id="saveAdminInfo" class="primary full">ذخیره اطلاعات</button>`;$('saveAdminInfo')?.addEventListener('click',async()=>{try{const c=await api('/api/conversations/'+adminConversation.id,{method:'PATCH',body:JSON.stringify({name:$('adminName').value,username:$('adminUsername')?.value||'',description:$('adminDesc').value})});adminConversation=c;await loadConvs();showToast('اطلاعات ذخیره شد')}catch(e){showToast(e.message,true)}});b.querySelector('#copyAdminLink')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(location.origin+'/#/join/'+adminConversation.username);showToast('لینک کپی شد')}catch{}});b.querySelectorAll('[data-remove-admin]').forEach(x=>x.onclick=async()=>{try{await api(`/api/conversations/${adminConversation.id}/admins/${x.dataset.removeAdmin}`,{method:'DELETE'});renderAdminTab('admins');showToast('ادمین حذف شد')}catch(e){showToast(e.message,true)}})}
async function promoteAdmin(uid){try{await api(`/api/conversations/${adminConversation.id}/admins`,{method:'POST',body:JSON.stringify({userId:uid,role:'admin',permissions:{post:true,edit:true,delete:true,invite:true,ban:true,manage:true}})});showToast('ادمین اضافه شد');renderAdminTab('admins')}catch(e){showToast(e.message,true)}}async function kickMember(uid){try{await api(`/api/conversations/${adminConversation.id}/members/${uid}`,{method:'DELETE'});adminConversation.members=adminConversation.members.filter(u=>Number(u.id)!==uid);renderAdminTab('members');loadConvs();showToast('عضو حذف شد')}catch(e){showToast(e.message,true)}}
$('search').oninput=()=>{clearTimeout(searchTimer);const q=$('search').value.trim();$('clearSearch').classList.toggle('hidden',!q);if(!q){$('userResults').innerHTML='';return}searchTimer=setTimeout(async()=>{try{const us=await api('/api/users?q='+encodeURIComponent(q));$('userResults').innerHTML=us.map(u=>`<button class="result-item" data-user="${u.id}">${avatar(u,'avatar')}<span><b>${esc(u.display_name)}</b><small>@${esc(u.username)}</small></span></button>`).join('');$('userResults').querySelectorAll('[data-user]').forEach(b=>b.onclick=async()=>{const c=await api('/api/conversations/direct',{method:'POST',body:JSON.stringify({userId:Number(b.dataset.user)})});$('search').value='';$('userResults').innerHTML='';await loadConvs();openConv(c.id)})}catch(e){showToast(e.message,true)}},250)};$('clearSearch').onclick=()=>{$('search').value='';$('userResults').innerHTML='';$('clearSearch').classList.add('hidden')};document.querySelectorAll('.chat-tabs button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.chat-tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');activeFilter=b.dataset.filter;renderConvs()});
async function logout(){localStorage.removeItem('zento_token');token=null;socket?.disconnect();showAuth()}
$('lightboxClose').onclick=()=>$('lightbox').classList.add('hidden');
// Auth tabs
$('loginForm').onsubmit=async e=>{e.preventDefault();try{const r=await api('/api/login',{method:'POST',body:JSON.stringify({email:$('loginEmail').value,password:$('loginPass').value})});token=r.token;localStorage.setItem('zento_token',token);await boot()}catch(err){showToast(err.message,true)}};$('registerForm').onsubmit=async e=>{e.preventDefault();try{const r=await api('/api/register',{method:'POST',body:JSON.stringify({displayName:$('regName').value,email:$('regEmail').value,password:$('regPass').value})});token=r.token;localStorage.setItem('zento_token',token);await boot()}catch(err){showToast(err.message,true)}};document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');$('loginForm').classList.toggle('hidden',b.dataset.tab!=='login');$('registerForm').classList.toggle('hidden',b.dataset.tab!=='register')});
// WebRTC calling
function installCallHandlers(){if(!socket)return;socket.on('call:offer',async d=>incomingCall(d));socket.on('call:answer',async d=>{try{if(call?.pc)await call.pc.setRemoteDescription(new RTCSessionDescription(d.answer));$('callStatusText').textContent='متصل'}catch(e){console.error('call answer',e);showToast('برقراری تماس ناموفق بود',true)}});socket.on('call:ice',async d=>{try{if(call?.pc&&d.candidate)await call.pc.addIceCandidate(new RTCIceCandidate(d.candidate))}catch(e){console.warn('call ice',e)}});socket.on('call:end',()=>endCall(false))}
async function startCall(video){if(!current||current.type!=='direct')return showToast('تماس فقط در گفتگوی خصوصی فعال است',true);const other=current.members.find(x=>Number(x.id)!==Number(me.id));if(!other)return;await openCallUI(other,video,false);call.pc=new RTCPeerConnection({iceServers:CALL_ICE});call.pc.onconnectionstatechange=()=>{const st=call?.pc?.connectionState;if(st==='connected')$('callStatusText').textContent='متصل';if(['failed','disconnected'].includes(st)){$('callStatusText').textContent='اتصال ناموفق یا ناپایدار است';showToast('تماس نتوانست برقرار شود؛ شبکه یا دسترسی میکروفون/دوربین را بررسی کن',true)}};call.pc.onicecandidate=e=>e.candidate&&socket.emit('call:ice',{to:other.id,candidate:e.candidate});call.pc.ontrack=e=>{const v=$('remoteVideo');if(!v.srcObject)v.srcObject=new MediaStream();const incoming=e.streams?.[0];if(incoming){incoming.getTracks().forEach(t=>{if(!v.srcObject.getTracks().some(x=>x.id===t.id))v.srcObject.addTrack(t)})}else if(e.track&&!v.srcObject.getTracks().some(x=>x.id===e.track.id)){v.srcObject.addTrack(e.track)}v.classList.remove('hidden');$('callAvatar').style.display='none';v.onloadedmetadata=()=>v.play().catch(()=>{});v.play?.().catch(()=>{});};const stream=await navigator.mediaDevices.getUserMedia({audio:true,video:video});call.local=stream;$('localVideo').srcObject=stream;stream.getTracks().forEach(t=>call.pc.addTrack(t,stream));const offer=await call.pc.createOffer();await call.pc.setLocalDescription(offer);socket.emit('call:offer',{to:other.id,offer,video});$('callStatusText').textContent='در انتظار پاسخ…'}
async function incomingCall(d){const u=convs.flatMap(c=>c.members).find(x=>Number(x.id)===Number(d.from))||{display_name:'کاربر',id:d.from};await openCallUI(u,d.video,true);const c=call;c.pc=new RTCPeerConnection({iceServers:CALL_ICE});c.pc.onicecandidate=e=>e.candidate&&socket.emit('call:ice',{to:u.id,candidate:e.candidate});c.pc.ontrack=e=>{const v=$('remoteVideo');if(!v.srcObject)v.srcObject=new MediaStream();const incoming=e.streams?.[0];if(incoming){incoming.getTracks().forEach(t=>{if(!v.srcObject.getTracks().some(x=>x.id===t.id))v.srcObject.addTrack(t)})}else if(e.track&&!v.srcObject.getTracks().some(x=>x.id===e.track.id)){v.srcObject.addTrack(e.track)}v.classList.remove('hidden');$('callAvatar').style.display='none';v.onloadedmetadata=()=>v.play().catch(()=>{});v.play?.().catch(()=>{});};await c.pc.setRemoteDescription(new RTCSessionDescription(d.offer));$('callStatusText').textContent='تماس ورودی — پاسخ دهید'}
async function openCallUI(other,video,incoming){call={other,video,incoming,pc:null,local:null};$('callModal').classList.remove('hidden');$('callType').textContent=video?'تماس تصویری':'تماس صوتی';$('callName').textContent=other.display_name||'تماس';$('callAvatar').textContent=(other.display_name||'گ')[0];$('callAvatar').style.display=video?'grid':'none';$('cameraCall').style.display=video?'block':'none';$('localVideo').classList.toggle('hidden',!video);$('remoteVideo').classList.toggle('hidden',!video);$('remoteVideo').srcObject=null;$('acceptCall').classList.toggle('hidden',!incoming);$('rejectCall').classList.toggle('hidden',!incoming)}
$('callAudio').onclick=()=>startCall(false);$('callVideo').onclick=()=>startCall(true);$('endCall').onclick=()=>endCall(true);$('rejectCall').onclick=()=>endCall(true);$('acceptCall').onclick=async()=>{if(!call?.incoming)return;try{const c=call,stream=await navigator.mediaDevices.getUserMedia({audio:true,video:c.video});c.local=stream;$('localVideo').srcObject=stream;stream.getTracks().forEach(t=>c.pc.addTrack(t,stream));const answer=await c.pc.createAnswer();await c.pc.setLocalDescription(answer);socket.emit('call:answer',{to:c.other.id,answer});$('acceptCall').classList.add('hidden');$('rejectCall').classList.add('hidden');$('callStatusText').textContent='متصل';}catch(e){showToast('دسترسی دوربین/میکروفون ممکن نیست',true)}};
async function incomingSetup(){ }
async function endCall(send=true){if(!call)return;if(send&&socket)socket.emit('call:end',{to:call.other.id});call.local?.getTracks().forEach(t=>t.stop());call.pc?.close();call=null;$('callModal').classList.add('hidden');$('remoteVideo').srcObject=null;$('remoteVideo').classList.add('hidden');$('callAvatar').style.display='grid';$('localVideo').srcObject=null}
$('muteCall').onclick=()=>{const t=call?.local?.getAudioTracks()[0];if(t){t.enabled=!t.enabled;$('muteCall').textContent=t.enabled?'🎙':'🔇'}};$('cameraCall').onclick=()=>{const t=call?.local?.getVideoTracks()[0];if(t)t.enabled=!t.enabled};$('screenShareCall').onclick=()=>{if(!call)return showToast('ابتدا تماس تصویری برقرار کن',true);if(!call.video)return showToast('اشتراک صفحه در تماس صوتی فعال نیست',true);toggleScreenShare()};$('speakerCall').onclick=()=>showToast('کنترل صدای تماس از تنظیمات دستگاه انجام می‌شود');

/* ================= Zento Stage 1 ================= */
let stage1Theme={accent:'#3390ec',mine:'#2b6cff',theirs:'#ffffff',background:'#dce9f4',bubbleRadius:18,shadow:true,fontSize:15,compact:false};
let stage1Folders=[],stage1Folder='all',stage1Profiles=[],stage1ProfileByConv={};
function stage1ApplyTheme(t){stage1Theme={...stage1Theme,...(t||{})};const r=document.documentElement;r.style.setProperty('--g-accent',stage1Theme.accent);r.style.setProperty('--g-mine',stage1Theme.mine);r.style.setProperty('--g-theirs',stage1Theme.theirs);r.style.setProperty('--g-chat-bg',stage1Theme.background);r.style.setProperty('--g-radius',stage1Theme.bubbleRadius+'px');r.style.setProperty('--g-font',stage1Theme.fontSize+'px');document.body.classList.toggle('g-stage1-shadow',!!stage1Theme.shadow);document.body.classList.toggle('g-stage1-compact',!!stage1Theme.compact)}
function stage1Style(){if(document.getElementById('stage1-style'))return;const st=document.createElement('style');st.id='stage1-style';st.textContent=`
:root{--g-accent:#3390ec;--g-mine:#2b6cff;--g-theirs:#fff;--g-chat-bg:#dce9f4;--g-radius:18px;--g-font:15px}
#messages{background:var(--g-chat-bg)!important;font-size:var(--g-font)}.bubble{border-radius:var(--g-radius)!important}.mine .bubble{background:var(--g-mine)!important}.g-stage1-shadow .bubble{box-shadow:0 2px 10px rgba(0,0,0,.10)}.g-stage1-compact .bubble-row{margin-top:3px!important}.g-stage1-compact .bubble{padding:7px 9px!important}
.stage1-folders{display:flex;gap:6px;overflow:auto;padding:6px 8px;border-bottom:1px solid rgba(0,0,0,.08);scrollbar-width:none}.stage1-folders::-webkit-scrollbar{display:none}.stage1-folder{border:0;border-radius:999px;padding:7px 11px;background:rgba(128,128,128,.10);white-space:nowrap;cursor:pointer}.stage1-folder.active{background:var(--g-accent);color:#fff}.stage1-folder-add{border:1px dashed #aaa;background:transparent}.stage1-theme-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.stage1-theme-grid label{display:flex;flex-direction:column;gap:6px}.stage1-theme-grid input[type=color]{height:42px;padding:3px}.stage1-profile-card{display:flex;align-items:center;gap:10px;padding:10px;border:1px solid rgba(128,128,128,.18);border-radius:14px;margin:7px 0}.stage1-profile-card .stage1-actions{margin-inline-start:auto}.stage1-profile-pill{font-size:11px;padding:3px 7px;border-radius:10px;background:rgba(51,144,236,.12);color:var(--g-accent)}
@media(max-width:700px){.stage1-theme-grid{grid-template-columns:1fr}.stage1-folders{padding-bottom:8px}}
`;document.head.appendChild(st)}
async function stage1Load(){try{const p=await api('/api/preferences');stage1ApplyTheme(p.theme)}catch{}try{stage1Folders=await api('/api/folders')}catch{stage1Folders=[]}try{stage1Profiles=await api('/api/profiles')}catch{stage1Profiles=[]}if(stage1Profiles.length)stage1Profiles.forEach(p=>{if(p.is_default)stage1ProfileByConv._default=p.id});stage1RenderFolders()}
function stage1EnsureFolderBar(){let b=$('stage1Folders');if(!b&&$('chats')){ $('chats').insertAdjacentHTML('beforebegin','<div id="stage1Folders" class="stage1-folders"></div>');b=$('stage1Folders')}return b}
function stage1RenderFolders(){const b=stage1EnsureFolderBar();if(!b)return;b.innerHTML=[{id:'all',name:'همه',icon:'💬'},...stage1Folders.map(f=>({id:String(f.id),name:f.name,icon:f.icon})),{id:'__add',name:'پوشه جدید',icon:'＋'}].map(f=>`<button class="stage1-folder ${String(stage1Folder)===String(f.id)?'active':''}" data-folder="${esc(f.id)}">${f.icon} ${esc(f.name)}</button>`).join('');b.querySelectorAll('[data-folder]').forEach(x=>x.onclick=async()=>{if(x.dataset.folder==='__add'){const name=prompt('نام پوشه:');if(!name?.trim())return;try{const f=await api('/api/folders',{method:'POST',body:JSON.stringify({name:name.trim(),icon:'📁'})});stage1Folders.push(f);stage1Folder=String(f.id);stage1RenderFolders();renderConvs()}catch(e){showToast(e.message,true)}}else{stage1Folder=x.dataset.folder;stage1RenderFolders();renderConvs()}})}
function stage1RenderConvs(){const base=stage1Folder==='all'?convs:convs.filter(c=>{const f=stage1Folders.find(x=>String(x.id)===String(stage1Folder));return f?.conversations?.map(Number).includes(Number(c.id))});const list=activeFilter==='all'?base:base.filter(c=>c.type===activeFilter);$('chats').innerHTML=list.map(c=>{const other=c.type==='direct'?c.members.find(x=>Number(x.id)!==Number(me.id)):null;const title=c.type==='direct'?(other?.display_name||'گفتگو'):c.name;const icon=c.type==='channel'?'📢':c.type==='group'?'👥':'گ';const locked=c.stage1Locked?' 🔐':'';return `<button class="chat-item ${current&&Number(current.id)===Number(c.id)?'active':''}" data-id="${c.id}">${c.type==='direct'?avatar(other):`<div class="avatar">${icon}</div>`}<div class="ci"><b>${esc(title)}${locked}</b><small>${c.type==='channel'?'کانال':c.type==='group'?`${c.members.length} عضو`:'@'+esc(other?.username||'')} · ${esc(c.last_text||'')}</small></div><span class="type-badge">${c.unread_count>0?`<b class="unread-badge">${c.unread_count>99?'99+':c.unread_count}</b>`:''}${c.type==='channel'?'کانال':c.type==='group'?'گروه':'خصوصی'}</span></button>`}).join('')||'<div class="empty"><span>گفتگویی پیدا نشد</span></div>'}
renderConvs=stage1RenderConvs;
const originalOpenConv=openConv;
async function stage1OpenConv(id){const c=convs.find(x=>Number(x.id)===Number(id));if(!c)return;try{const st=await api('/api/conversations/'+id+'/lock');c.stage1Locked=!!st.locked;if(st.locked){const pin=prompt('🔐 این گفتگو قفل است. PIN را وارد کنید:');if(pin===null)return;await api('/api/conversations/'+id+'/unlock',{method:'POST',body:JSON.stringify({pin})})}}catch(e){showToast(e.message,true);return}try{const p=await api('/api/conversations/'+id+'/profile');if(p)stage1ProfileByConv[id]=p.id}catch{}return originalOpenConv(id)}
openConv=stage1OpenConv;
async function stage1LockMenu(c){const st=await api('/api/conversations/'+c.id+'/lock');if(st.locked){if(confirm('قفل این گفتگو برداشته شود؟')){const pin=prompt('PIN فعلی را وارد کنید:');if(pin===null)return;try{await api('/api/conversations/'+c.id+'/unlock',{method:'POST',body:JSON.stringify({pin})});await api('/api/conversations/'+c.id+'/lock',{method:'DELETE'});c.stage1Locked=false;renderConvs();showToast('قفل برداشته شد')}catch(e){showToast(e.message,true)}}}else{const a=prompt('یک PIN چهار تا هشت رقمی وارد کنید:');if(!a)return;const b=prompt('PIN را دوباره وارد کنید:');if(a!==b)return showToast('PINها یکسان نیستند',true);try{await api('/api/conversations/'+c.id+'/lock',{method:'POST',body:JSON.stringify({pin:a})});c.stage1Locked=true;renderConvs();showToast('گفتگو قفل شد 🔐')}catch(e){showToast(e.message,true)}}}
$('chats').addEventListener('contextmenu',e=>{const x=e.target.closest('.chat-item');if(!x)return;e.preventDefault();const c=convs.find(z=>Number(z.id)===Number(x.dataset.id));if(c)stage1LockMenu(c)});
let stage1Long=null;$('chats').addEventListener('pointerdown',e=>{const x=e.target.closest('.chat-item');if(!x)return;stage1Long=setTimeout(()=>{const c=convs.find(z=>Number(z.id)===Number(x.dataset.id));if(c)stage1LockMenu(c)},700)});['pointerup','pointercancel','pointerleave'].forEach(ev=>$('chats').addEventListener(ev,()=>clearTimeout(stage1Long)));
async function stage1AddToFolder(c){if(!stage1Folders.length){showToast('اول یک پوشه بساز');return}const f=prompt('نام دقیق پوشه:');const folder=stage1Folders.find(x=>x.name===f);if(!folder)return showToast('پوشه پیدا نشد',true);try{await api(`/api/folders/${folder.id}/conversations/${c.id}`,{method:'POST'});stage1Folders=await api('/api/folders');stage1RenderFolders();renderConvs();showToast('به پوشه اضافه شد')}catch(e){showToast(e.message,true)}}
const oldRenderSettings=renderSettings;renderSettings=function(section){if(section!=='appearance'){oldRenderSettings(section);return}const c=$('settingsContent');c.innerHTML=`<div class="settings-content"><h4>🎨 شخصی‌سازی ظاهر</h4><div class="stage1-theme-grid"><label>رنگ اصلی<input id="s1Accent" type="color" value="${esc(stage1Theme.accent)}"></label><label>حباب پیام من<input id="s1Mine" type="color" value="${esc(stage1Theme.mine)}"></label><label>حباب طرف مقابل<input id="s1Theirs" type="color" value="${esc(stage1Theme.theirs)}"></label><label>پس‌زمینه چت<input id="s1Bg" type="color" value="${esc(stage1Theme.background)}"></label><label>گردی حباب<input id="s1Radius" type="range" min="6" max="30" value="${stage1Theme.bubbleRadius}"><span id="s1RadiusV">${stage1Theme.bubbleRadius}px</span></label><label>اندازه متن<input id="s1Font" type="range" min="12" max="22" value="${stage1Theme.fontSize}"><span id="s1FontV">${stage1Theme.fontSize}px</span></label></div><div class="setting-row"><div><b>سایه حباب</b><small>نمایش سایه نرم زیر پیام‌ها</small></div><button id="s1Shadow" class="switch ${stage1Theme.shadow?'on':''}"></button></div><div class="setting-row"><div><b>نمای فشرده</b><small>فاصله کمتر بین پیام‌ها</small></div><button id="s1Compact" class="switch ${stage1Theme.compact?'on':''}"></button></div><button id="s1SaveTheme" class="primary full">ذخیره ظاهر</button></div>`;$('s1Radius').oninput=e=>{$('s1RadiusV').textContent=e.target.value+'px';stage1Theme.bubbleRadius=Number(e.target.value);stage1ApplyTheme(stage1Theme)};$('s1Font').oninput=e=>{$('s1FontV').textContent=e.target.value+'px';stage1Theme.fontSize=Number(e.target.value);stage1ApplyTheme(stage1Theme)};$('s1Shadow').onclick=()=>{stage1Theme.shadow=!stage1Theme.shadow;stage1ApplyTheme(stage1Theme);$('s1Shadow').classList.toggle('on',stage1Theme.shadow)};$('s1Compact').onclick=()=>{stage1Theme.compact=!stage1Theme.compact;stage1ApplyTheme(stage1Theme);$('s1Compact').classList.toggle('on',stage1Theme.compact)};$('s1SaveTheme').onclick=async()=>{stage1Theme.accent=$('s1Accent').value;stage1Theme.mine=$('s1Mine').value;stage1Theme.theirs=$('s1Theirs').value;stage1Theme.background=$('s1Bg').value;stage1ApplyTheme(stage1Theme);await api('/api/preferences',{method:'PUT',body:JSON.stringify({theme:stage1Theme})});showToast('ظاهر ذخیره شد')}};
async function stage1ProfilesModal(){stage1Profiles=await api('/api/profiles');openModal('👤 پروفایل‌های من',`<p>برای هر محیط یک نام، آیدی، عکس و بیو جدا داشته باش.</p><div id="s1Profiles">${stage1Profiles.map(p=>`<div class="stage1-profile-card"><div class="avatar">${esc((p.name||'گ')[0])}</div><div><b>${esc(p.name)}</b><small>@${esc(p.username)}</small>${p.is_default?'<div class="stage1-profile-pill">اصلی</div>':''}</div><div class="stage1-actions">${!p.is_default?`<button data-pdel="${p.id}" class="danger">حذف</button>`:''}</div></div>`).join('')}</div><hr><label>نام<input id="s1pName"></label><label>نام کاربری<input id="s1pUser" placeholder="work_user"></label><label>بیو<input id="s1pBio"></label><button id="s1pAdd" class="primary full">ساخت پروفایل</button>`,async()=>{});$('modalOk').classList.add('hidden');$('s1pAdd').onclick=async()=>{try{const p=await api('/api/profiles',{method:'POST',body:JSON.stringify({name:$('s1pName').value,username:$('s1pUser').value,bio:$('s1pBio').value})});stage1Profiles.push(p);showToast('پروفایل ساخته شد');stage1ProfilesModal()}catch(e){showToast(e.message,true)}};document.querySelectorAll('[data-pdel]').forEach(b=>b.onclick=async()=>{try{await api('/api/profiles/'+b.dataset.pdel,{method:'DELETE'});stage1ProfilesModal()}catch(e){showToast(e.message,true)}})}
function stage1AddProfileButton(){if($('stage1ProfileBtn')||!$('profileModal'))return;const host=$('profileModal').querySelector('.modal-actions')||$('profileModal');host.insertAdjacentHTML('beforeend','<button id="stage1ProfileBtn" type="button" class="secondary">👤 پروفایل‌های چندگانه</button>');$('stage1ProfileBtn').onclick=stage1ProfilesModal}
const oldRefreshUserUI=refreshUserUI;refreshUserUI=function(){oldRefreshUserUI();stage1AddProfileButton()};
$('composer').onsubmit=async e=>{e.preventDefault();if(!current)return;const text=$('text').value.trim();if(!text)return;try{const out=await api('/api/messages',{method:'POST',body:JSON.stringify({conversationId:current.id,text,replyTo,profileId:stage1ProfileByConv[current.id]||stage1ProfileByConv._default,quoteIds:selectedStage2Messages,expiresIn:current.stage2Expiry||null})});$('text').value='';replyTo=null;selectedStage2Messages=[];document.querySelectorAll('.bubble-row.selected').forEach(x=>x.classList.remove('selected'));$('replyBar').classList.add('hidden');appendMessage(out);scrollBottom();if(socket?.connected)socket.emit('typing',{conversationId:current.id,typing:false})}catch(err){showToast(err.message,true)}};

const s2style=document.createElement('style');s2style.textContent=`.unread-badge{display:inline-flex;align-items:center;justify-content:center;min-width:22px;height:22px;padding:0 6px;border-radius:11px;background:#229ed9;color:#fff;font-size:12px;margin-inline-end:5px}.msg-status{font-size:12px;margin-inline-start:4px;color:#777}.msg-status.read{color:#229ed9}.bubble-row.selected .bubble{outline:2px solid #229ed9}.stage2-highlight .bubble{animation:stage2flash 1.8s ease}.quote-block{padding:6px 9px;margin-bottom:6px;border-inline-start:3px solid #229ed9;background:rgba(34,158,217,.08);border-radius:7px}.expiry-note{display:block;opacity:.65;margin-top:4px}.search-result{display:block;width:100%;text-align:start;padding:10px;border:0;background:transparent;border-bottom:1px solid rgba(0,0,0,.08);cursor:pointer}@keyframes stage2flash{0%,100%{box-shadow:0 0 0 transparent}30%{box-shadow:0 0 0 5px rgba(34,158,217,.35)}}`;document.head.appendChild(s2style);

const stage2OldChatMore=$('chatMore').onclick;
$('chatMore').onclick=()=>{if(current){const action=prompt('گزینه را انتخاب کن:\n1 = تنظیم پیام‌های ناپدیدشونده\n2 = جستجو در گفتگو\n3 = کپی لینک گفتگو','2');if(action==='1')return stage2SetExpiry();if(action==='2')return stage2SearchDialog();}if(stage2OldChatMore)stage2OldChatMore()};

stage1Style();
const _stage1Boot=boot;boot=async()=>{await _stage1Boot();if(token&&me)await stage1Load()};

boot().then(()=>window.stage2HandleMessageHash?.()).catch(e=>console.error('boot',e));

document.addEventListener('click',e=>{const a=e.target.closest('.mention');if(a){e.preventDefault();const u=a.dataset.username;api('/api/users?q='+encodeURIComponent(u)).then(us=>{const x=us.find(z=>String(z.username).toLowerCase()===String(u).toLowerCase());if(x)openUserProfile(x.id);else showToast('کاربر پیدا نشد',true)}).catch(()=>{})}});

/* ===== Zento Stage 3 ===== */
(function(){
  const css=document.createElement('style');css.textContent=`
  .stage3-modal{max-height:78vh;overflow:auto}.stage3-hero{padding:18px;background:linear-gradient(135deg,var(--accent),#5b7cfa);color:#fff;border-radius:0 0 22px 22px}.stage3-hero b{font-size:22px;display:block}.stage3-hero small{opacity:.9}.stage3-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;padding:14px}.stage3-stat{padding:15px 8px;border:1px solid var(--line);border-radius:15px;background:var(--panel2);text-align:center}.stage3-stat b{display:block;font-size:22px;color:var(--accent)}.stage3-stat small{font-size:9px;color:var(--muted)}.stage3-badges{padding:8px 14px}.stage3-badge{display:flex;gap:12px;align-items:center;padding:12px;border:1px solid var(--line);border-radius:14px;background:var(--panel2);margin-bottom:8px}.stage3-badge-icon{font-size:27px}.stage3-badge b{display:block}.stage3-badge small{color:var(--muted)}.stage3-section{padding:12px 18px}.stage3-section h4{margin:4px 0 10px}.stage3-setting{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line)}.stage3-setting small{display:block;color:var(--muted);margin-top:3px}.stage3-admin-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px 18px}.stage3-admin-grid label{display:flex;align-items:center;gap:7px;padding:10px;border:1px solid var(--line);border-radius:11px;font-size:10px}.stage3-admin-grid input{width:auto}.stage3-notice{position:fixed;right:18px;bottom:80px;z-index:100;background:var(--panel);border:1px solid var(--line);box-shadow:0 12px 35px rgba(0,0,0,.18);border-radius:15px;padding:11px 14px;max-width:310px}.stage3-notice b{display:block}.stage3-notice small{color:var(--muted)}
  @media(max-width:850px){.stage3-stats{grid-template-columns:repeat(2,1fr)}.stage3-notice{right:8px;left:8px;max-width:none}}
  `;document.head.appendChild(css);

  function addDrawerButtons(){
    const list=document.querySelector('.drawer-list'); if(!list||document.getElementById('stage3StatsBtn'))return;
    const sep=document.createElement('div');sep.className='drawer-sep';
    const stats=document.createElement('button');stats.id='stage3StatsBtn';stats.innerHTML='📊 <span>آمار و نشان‌های من</span>';stats.onclick=()=>{closeDrawer();stage3StatsModal()};
    const badges=document.createElement('button');badges.id='stage3BadgesBtn';badges.innerHTML='🏆 <span>نشان‌های کاربری</span>';badges.onclick=()=>{closeDrawer();stage3BadgesModal()};
    const anchor=document.getElementById('drawerSettings');list.insertBefore(sep,anchor);list.insertBefore(stats,anchor);list.insertBefore(badges,anchor);
  }
  async function stage3StatsModal(){
    try{
      const [s,b]=await Promise.all([api('/api/stats'),api('/api/badges')]);
      openModal('📊 آمار زنتو',`<div class="stage3-modal"><div class="stage3-hero"><b>${esc(me?.display_name||'کاربر')}</b><small>@${esc(me?.username||'')}</small></div><div class="stage3-stats"><div class="stage3-stat"><b>${s.messages}</b><small>پیام ارسال‌شده</small></div><div class="stage3-stat"><b>${s.groups}</b><small>گروه</small></div><div class="stage3-stat"><b>${s.channels}</b><small>کانال</small></div><div class="stage3-stat"><b>${s.files}</b><small>فایل و رسانه</small></div><div class="stage3-stat"><b>${s.contacts}</b><small>مخاطب</small></div><div class="stage3-stat"><b>${Math.floor((Date.now()-new Date(s.account_created_at).getTime())/86400000)||0}</b><small>روز عضویت</small></div></div><div class="stage3-section"><h4>🏆 نشان‌های شما</h4><div class="stage3-badges">${b.map(x=>`<div class="stage3-badge"><span class="stage3-badge-icon">${x.icon}</span><div><b>${esc(x.name)}</b><small>${esc(x.description)}</small></div></div>`).join('')}</div></div></div>`,()=>{});
      $('modalOk').classList.add('hidden');$('modalCancel').textContent='بستن';
    }catch(e){showToast(e.message,true)}
  }
  async function stage3BadgesModal(){
    try{const b=await api('/api/badges');openModal('🏆 نشان‌های کاربری',`<div class="stage3-modal"><div class="stage3-badges">${b.map(x=>`<div class="stage3-badge"><span class="stage3-badge-icon">${x.icon}</span><div><b>${esc(x.name)}</b><small>${esc(x.description)}</small></div></div>`).join('')}</div></div>`,()=>{});$('modalOk').classList.add('hidden');$('modalCancel').textContent='بستن'}catch(e){showToast(e.message,true)}
  }
  async function stage3Management(){
    if(!current||!['group','channel'].includes(current.type))return;
    try{
      const d=await api('/api/conversations/'+current.id+'/management');
      const owner=Number(d.owner_id)===Number(me.id), can=owner||d.role==='admin'||d.role==='moderator';
      if(!can)return showToast('دسترسی مدیریت ندارید',true);
      const st={...(d.conversation.settings||{})};
      openModal('⚙️ تنظیمات حرفه‌ای',`<div class="stage3-modal"><div class="feature-intro">تنظیمات ${d.conversation.type==='channel'?'کانال':'گروه'} را مدیریت کن.</div><div class="stage3-admin-grid"><label><input id="s3Slow" type="checkbox" ${st.slowMode?'checked':''}> حالت کند</label><label><input id="s3Only" type="checkbox" ${st.onlyAdminsPost?'checked':''}> فقط ادمین‌ها ارسال کنند</label><label><input id="s3Approval" type="checkbox" ${st.approval?'checked':''}> تأیید اعضای جدید</label><label><input id="s3Hide" type="checkbox" ${st.hideMembers?'checked':''}> مخفی‌کردن اعضا</label><label><input id="s3Comments" type="checkbox" ${st.comments?'checked':''}> فعال بودن نظرها</label></div>${owner?`<div class="stage3-section"><h4>👑 ادمین‌ها</h4><p class="feature-intro">برای افزودن ادمین، شناسه عددی کاربر عضو را وارد کن.</p><label>شناسه کاربر<input id="s3AdminUser" inputmode="numeric" placeholder="مثلاً 12"></label><button id="s3AddAdmin" class="primary full">افزودن ادمین</button><div class="folder-list">${d.admins.map(a=>`<div class="folder-edit-row"><span><b>${esc(a.display_name)}</b><small>@${esc(a.username)} · ${esc(a.role)}</small></span>${Number(a.user_id)!==Number(d.owner_id)?`<button class="danger" data-s3-del="${a.user_id}">حذف</button>`:''}</div>`).join('')}</div></div>`:''}</div>`,async()=>{});
      $('modalOk').textContent='ذخیره';$('modalCancel').textContent='بستن';
      $('modalOk').onclick=async()=>{try{await api('/api/conversations/'+current.id+'/management',{method:'PUT',body:JSON.stringify({settings:{slowMode:$('s3Slow').checked,onlyAdminsPost:$('s3Only').checked,approval:$('s3Approval').checked,hideMembers:$('s3Hide').checked,comments:$('s3Comments').checked}})});showToast('تنظیمات ذخیره شد');$('modal').classList.add('hidden')}catch(e){showToast(e.message,true)}};
      $('s3AddAdmin')?.addEventListener('click',async()=>{try{await api('/api/conversations/'+current.id+'/admins',{method:'POST',body:JSON.stringify({userId:Number($('s3AdminUser').value),permissions:{post:true,edit:true,delete:true,invite:true,ban:true,manage:true}})});showToast('ادمین اضافه شد');stage3Management()}catch(e){showToast(e.message,true)}});
      document.querySelectorAll('[data-s3-del]').forEach(b=>b.onclick=async()=>{try{await api('/api/conversations/'+current.id+'/admins/'+b.dataset.s3Del,{method:'DELETE'});stage3Management()}catch(e){showToast(e.message,true)}});
    }catch(e){showToast(e.message,true)}
  }
  function showSmartNotice(title,text,count){
    const old=document.querySelector('.stage3-notice');old?.remove();const n=document.createElement('div');n.className='stage3-notice';n.innerHTML=`<b>${esc(title)} ${count>1?`· ${count} پیام`:''}</b><small>${esc(text||'پیام جدید')}</small>`;n.onclick=()=>{const c=convs.find(x=>x.name===title);if(c)openConv(c.id);n.remove()};document.body.appendChild(n);setTimeout(()=>n.remove(),5000);
  }
  let notificationQueue=new Map(),notificationTimers=new Map();
  function stage3Notify(m){
    if(!m||!current||Number(m.conversation_id)===Number(current.id))return;
    const c=convs.find(x=>Number(x.id)===Number(m.conversation_id));if(!c)return;
    const count=(notificationQueue.get(c.id)||0)+1;notificationQueue.set(c.id,count);
    clearTimeout(notificationTimers.get(c.id));notificationTimers.set(c.id,setTimeout(()=>{const n=notificationQueue.get(c.id)||1;notificationQueue.delete(c.id);showSmartNotice(c.type==='direct'?(c.members.find(x=>Number(x.id)!==Number(me.id))?.display_name||c.name):c.name,m.text,n);if(settings.notifications?.messages!==false&&'Notification' in window&&Notification.permission==='granted')new Notification(c.name,{body:n>1?`${n} پیام جدید`:(m.text||'پیام جدید'),tag:'zento-'+c.id});},900));
  }
  const oldConnect=connectSocket;
  connectSocket=function(){oldConnect();if(window.Notification&&Notification.permission==='default'&&settings.notifications?.messages!==false)Notification.requestPermission().catch(()=>{});socket?.on('message',stage3Notify)};
  const oldOpenAdmin=openAdmin;
  openAdmin=function(c){oldOpenAdmin(c);setTimeout(()=>{if(!document.getElementById('stage3ManageBtn')){const b=document.createElement('button');b.id='stage3ManageBtn';b.className='primary full';b.textContent='⚙️ مدیریت حرفه‌ای';b.onclick=stage3Management;$('adminBody').prepend(b)}},50)};
  addDrawerButtons();
  setTimeout(addDrawerButtons,800);
})();

/* ===== Zento Stage 4 — Multi-device, Bots, Mini Apps, Games, AI, Screen Share, PWA ===== */
(function(){
  const css=document.createElement('style');css.textContent=`
  .s4-modal{max-height:78vh;overflow:auto}.s4-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;padding:14px 18px}.s4-card{border:1px solid var(--line);background:var(--panel2);border-radius:16px;padding:14px;text-align:right;cursor:pointer;transition:.18s}.s4-card:hover{border-color:var(--accent);transform:translateY(-1px)}.s4-card b{display:block;font-size:13px;margin-bottom:5px}.s4-card small{color:var(--muted);line-height:1.7}.s4-hero{padding:18px;background:linear-gradient(135deg,var(--accent),#6a5cff);color:#fff}.s4-hero b{display:block;font-size:22px}.s4-hero small{opacity:.9}.s4-status{display:flex;gap:8px;align-items:center;padding:10px 18px;border-bottom:1px solid var(--line)}.s4-dot{width:9px;height:9px;border-radius:50%;background:#25c76f}.s4-dot.off{background:#aaa}.s4-list{padding:10px 18px}.s4-item{display:flex;align-items:center;gap:9px;padding:10px 0;border-bottom:1px solid var(--line)}.s4-item>div:first-child{flex:1}.s4-token{font-family:monospace;background:#111923;color:#fff;border-radius:10px;padding:9px;word-break:break-all;font-size:10px;margin-top:7px}.s4-actions{display:flex;gap:7px;flex-wrap:wrap;padding:10px 18px}.s4-actions button,.s4-form button{padding:9px 12px;border-radius:10px}.s4-form{display:grid;gap:8px;padding:12px 18px}.s4-form input,.s4-form textarea{width:100%}.s4-iframe{width:100%;height:62vh;border:0;background:#fff;border-radius:14px}.s4-game{display:grid;justify-items:center;gap:12px;padding:18px}.s4-board{display:grid;grid-template-columns:repeat(3,78px);grid-template-rows:repeat(3,78px);gap:7px}.s4-board button{font-size:31px;border:1px solid var(--line);border-radius:14px;background:var(--panel2);color:var(--text)}.s4-game-status{font-weight:700;text-align:center}.s4-ai-out{white-space:pre-wrap;line-height:1.9;min-height:90px;max-height:38vh;overflow:auto;padding:12px 18px}.s4-install{margin:0 18px 12px}.s4-badge{font-size:9px;padding:4px 7px;border-radius:8px;background:rgba(34,158,217,.12);color:var(--accent)}
  @media(max-width:850px){.s4-grid{grid-template-columns:1fr;padding:9px}.s4-board{grid-template-columns:repeat(3,66px);grid-template-rows:repeat(3,66px)}.s4-iframe{height:70vh}}
  `;document.head.appendChild(css);

  let deviceId=localStorage.getItem('zento_device_id');
  if(!deviceId){deviceId=crypto.randomUUID?crypto.randomUUID():'dev_'+Date.now()+'_'+Math.random().toString(36).slice(2);localStorage.setItem('zento_device_id',deviceId)}
  let installPrompt=null, activeGame=null, gameModalOpen=false;
  window.addEventListener('beforeinstallprompt',e=>{installPrompt=e;});
  window.addEventListener('appinstalled',()=>{installPrompt=null;showToast('زنتو روی دستگاه نصب شد 📲')});

  function stage4Modal(title,body,opts={}){
    openModal(title,body,async()=>{});
    $('modalOk').textContent=opts.ok||'بستن';$('modalCancel').textContent=opts.cancel||'لغو';
    $('modalOk').classList.toggle('hidden',!!opts.hideOk);$('modalCancel').classList.remove('hidden');
    $('modalOk').onclick=opts.onOk||(()=>{$('modal').classList.add('hidden')});
    $('modalCancel').onclick=opts.onCancel||(()=>{$('modal').classList.add('hidden')});
  }
  function addDrawer(){
    const list=document.querySelector('.drawer-list');if(!list||$('stage4HubBtn'))return;
    const sep=document.createElement('div');sep.className='drawer-sep';
    const hub=document.createElement('button');hub.id='stage4HubBtn';hub.innerHTML='🚀 <span>امکانات پیشرفته</span>';hub.onclick=()=>{closeDrawer();stage4Hub()};
    const bots=document.createElement('button');bots.id='stage4BotsBtn';bots.innerHTML='🤖 <span>ربات‌ها</span>';bots.onclick=()=>{closeDrawer();botsModal()};
    const ai=document.createElement('button');ai.id='stage4AiBtn';ai.innerHTML='✨ <span>دستیار AI</span>';ai.onclick=()=>{closeDrawer();aiModal()};
    list.insertBefore(sep,document.getElementById('drawerSettings'));list.insertBefore(hub,document.getElementById('drawerSettings'));list.insertBefore(bots,document.getElementById('drawerSettings'));list.insertBefore(ai,document.getElementById('drawerSettings'));
  }
  async function stage4Hub(){
    const connected=!!socket?.connected;
    stage4Modal('🚀 امکانات پیشرفته زنتو',`<div class="s4-modal"><div class="s4-hero"><b>Zento Stage 4</b><small>همگام‌سازی چنددستگاهی، ربات، مینی‌اپ، بازی، AI و PWA</small></div><div class="s4-status"><span class="s4-dot ${connected?'':'off'}"></span><div><b>${connected?'همگام‌سازی لحظه‌ای فعال است':'در حال اتصال…'}</b><small>شناسه دستگاه: ${esc(deviceId.slice(0,18))}</small></div></div><div class="s4-grid"><button class="s4-card" id="s4Sync"><b>💻📱 Multi-device Sync</b><small>پیام‌ها و رویدادها بین دستگاه‌های همین حساب لحظه‌ای هماهنگ می‌شوند.</small></button><button class="s4-card" id="s4Bot"><b>🤖 Bot API</b><small>ساخت ربات، توکن امن و دستورهای ساده API.</small></button><button class="s4-card" id="s4Mini"><b>🚀 Mini Apps</b><small>اجرای ابزار یا بازی وب داخل پیام‌رسان.</small></button><button class="s4-card" id="s4Game"><b>🎮 بازی Real-time</b><small>دوز دو نفره داخل گفتگو با Socket.IO.</small></button><button class="s4-card" id="s4AI"><b>🤖✨ AI</b><small>خلاصه‌سازی، ترجمه، بازنویسی و پاسخ به سؤال.</small></button><button class="s4-card" id="s4Pwa"><b>📲 نصب PWA</b><small>زنتو را مثل اپلیکیشن مستقل روی دستگاه نصب کن.</small></button><button class="s4-card" id="s4Call"><b>🖥️ Screen Share</b><small>اشتراک‌گذاری صفحه در تماس تصویری.</small></button></div></div>`,{hideOk:true});
    $('s4Sync').onclick=()=>{stage4Modal('💻📱 Multi-device Sync',`<div class="s4-modal"><div class="s4-hero"><b>همگام‌سازی چنددستگاهی</b><small>این حساب می‌تواند همزمان روی موبایل، دسکتاپ و مرورگر فعال باشد.</small></div><div class="s4-list"><div class="s4-item"><div><b>دستگاه فعلی</b><small>${esc(deviceId)}</small></div><span class="s4-badge">${socket?.connected?'متصل':'آفلاین'}</span></div><div class="s4-item"><div><b>ذخیره پیام‌ها</b><small>پیام‌ها از PostgreSQL و رویدادهای جدید از Socket.IO دریافت می‌شوند.</small></div><span>✓</span></div><div class="s4-item"><div><b>تعداد نشست‌های آنلاین</b><small id="s4DeviceCount">در حال دریافت…</small></div></div></div></div>`,{hideOk:true});
      if(socket?.connected)socket.emit('device:hello',{deviceId});
    };
    $('s4Bot').onclick=botsModal;$('s4Mini').onclick=miniAppsModal;$('s4Game').onclick=()=>{if(!current)return showToast('اول یک گفتگو را انتخاب کن',true);gameModal(current.id)};$('s4AI').onclick=aiModal;$('s4Pwa').onclick=installPwa;$('s4Call').onclick=()=>{if(call)toggleScreenShare();else showToast('اول یک تماس تصویری برقرار کن',true)};
  }
  async function botsModal(){
    try{const bots=await api('/api/bots');stage4Modal('🤖 ربات‌های زنتو',`<div class="s4-modal"><div class="feature-intro">ربات بساز و از Bot API برای ارسال پیام استفاده کن.</div><div class="s4-form"><input id="s4BotName" placeholder="نام ربات"><input id="s4BotUser" placeholder="username (انگلیسی)"><textarea id="s4BotDesc" placeholder="توضیحات"></textarea><input id="s4BotWebhook" placeholder="Webhook URL (اختیاری)"><button id="s4CreateBot" class="primary">ساخت ربات</button></div><div class="s4-list">${bots.map(b=>`<div class="s4-item"><div><b>${esc(b.name)} <span class="s4-badge">@${esc(b.username)}</span></b><small>${esc(b.description||'بدون توضیحات')}</small><div class="s4-token">${esc(b.token)}</div><small>POST /api/bot/&lt;TOKEN&gt;/send</small></div><button class="danger" data-s4-delbot="${b.id}">حذف</button></div>`).join('')||'<div class="feature-intro">هنوز رباتی نساخته‌ای.</div>'}</div></div>`,{hideOk:true});
      $('s4CreateBot').onclick=async()=>{try{const b=await api('/api/bots',{method:'POST',body:JSON.stringify({name:$('s4BotName').value,username:$('s4BotUser').value,description:$('s4BotDesc').value,webhookUrl:$('s4BotWebhook').value})});showToast('ربات ساخته شد 🤖');botsModal();}catch(e){showToast(e.message,true)}};
      document.querySelectorAll('[data-s4-delbot]').forEach(x=>x.onclick=async()=>{if(!confirm('این ربات حذف شود؟'))return;try{await api('/api/bots/'+x.dataset.s4Delbot,{method:'DELETE'});botsModal()}catch(e){showToast(e.message,true)}});
    }catch(e){showToast(e.message,true)}
  }
  function miniAppsModal(){
    stage4Modal('🚀 Mini Apps',`<div class="s4-modal"><div class="feature-intro">یک آدرس HTTPS از یک Mini App سازگار وارد کن. سایت مقصد باید اجازه نمایش در iframe بدهد.</div><div class="s4-form"><input id="s4MiniUrl" placeholder="https://example.com/app"><button id="s4OpenMini" class="primary">باز کردن Mini App</button></div><div class="s4-grid"><button class="s4-card" id="s4MiniGame"><b>🎮 بازی داخلی</b><small>باز کردن بازی دوز Real-time زنتو.</small></button><button class="s4-card" id="s4MiniTool"><b>🧮 ابزار نمونه</b><small>یک ماشین‌حساب سبک به‌عنوان Mini App.</small></button></div></div>`,{hideOk:true});
    $('s4OpenMini').onclick=()=>{const u=$('s4MiniUrl').value.trim();if(!/^https:\/\//i.test(u))return showToast('آدرس باید HTTPS باشد',true);stage4Modal('🚀 Mini App',`<div class="s4-modal"><iframe class="s4-iframe" src="${esc(u)}" sandbox="allow-scripts allow-forms allow-popups allow-modals"></iframe><div class="s4-actions"><button id="s4MiniNew">↗ باز کردن در صفحه جدید</button></div></div>`,{hideOk:true});$('s4MiniNew').onclick=()=>window.open(u,'_blank','noopener,noreferrer')};
    $('s4MiniGame').onclick=()=>{if(!current)return showToast('اول یک گفتگو را انتخاب کن',true);gameModal(current.id)};
    $('s4MiniTool').onclick=()=>stage4Modal('🧮 Mini App',`<div class="tool-calc"><input id="gc9Calc" placeholder="مثلاً 12*8+5"><button id="gc9CalcBtn" class="primary">محاسبه</button><div id="gc9CalcOut">—</div></div>`,{hideOk:true});
    setTimeout(()=>{$('gc9CalcBtn')?.addEventListener('click',()=>{try{const v=$('gc9Calc').value.replace(/[^0-9+\-*/().% ]/g,'');$('gc9CalcOut').textContent=v?String(Function('"use strict";return ('+v+')')()):'—'}catch{$('gc9CalcOut').textContent='عبارت نامعتبر'}})},0);
  }
  function gameModal(cid){
    gameModalOpen=true;stage4Modal('🎮 دوز Real-time',`<div class="s4-game"><div class="s4-game-status" id="s4GameStatus">در حال اتصال…</div><div id="s4Board" class="s4-board"></div><div class="s4-actions"><button id="s4JoinGame">🎮 ورود به بازی</button><button id="s4NewGame" class="primary">بازی جدید</button><button id="s4EndGame">پایان</button></div></div>`,{hideOk:true});
    const render=g=>{activeGame=g;const board=$('s4Board');if(!board)return;board.innerHTML=g.board.map((v,i)=>`<button data-cell="${i}">${v||' '}</button>`).join('');const meId=Number(me.id);const myTurn=g.players.length===2&&g.turn===meId&&!g.winner;$('s4GameStatus').textContent=g.winner?(g.winner==='draw'?'مساوی شد 🎯':Number(g.winner)===meId?'بردی! 🏆':'باختی 😄'):(g.players.length<2?'منتظر بازیکن دوم…':myTurn?'نوبت توست':'نوبت حریف است');board.querySelectorAll('[data-cell]').forEach(b=>b.onclick=()=>{if(myTurn&&!g.board[Number(b.dataset.cell)]&&socket?.connected)socket.emit('game:move',{conversationId:cid,cell:Number(b.dataset.cell)})})};
    $('s4JoinGame').onclick=()=>socket?.emit('game:join',cid);
    $('s4NewGame').onclick=async()=>{try{const g=await api('/api/games/start',{method:'POST',body:JSON.stringify({conversationId:cid})});render(g);socket?.emit('game:join',cid)}catch(e){showToast(e.message,true)}};
    $('s4EndGame').onclick=()=>{socket?.emit('game:end',cid);activeGame=null;$('modal').classList.add('hidden')};
    if(socket?.connected)socket.emit('game:join',cid);api('/api/games/'+cid).then(g=>{if(g)render(g);else $('s4GameStatus').textContent='برای شروع «بازی جدید» را بزن'}).catch(()=>{});
  }
  function aiModal(){
    stage4Modal('🤖✨ دستیار AI',`<div class="s4-modal"><div class="feature-intro">دستیار داخلی زنتو. قابلیت‌ها: پاسخ به سؤال، خلاصه‌سازی، ترجمه و بازنویسی.</div><div class="s4-form"><textarea id="s4AiPrompt" rows="5" placeholder="مثلاً: این متن را خلاصه کن...">${current?esc(Array.from(document.querySelectorAll('.body-text')).slice(-5).map(x=>x.textContent).join('\n')):''}</textarea><div class="s4-actions"><button data-ai="summarize">📝 خلاصه</button><button data-ai="translate">🌐 ترجمه</button><button data-ai="rewrite">✍️ بازنویسی</button><button data-ai="answer" class="primary">💡 پاسخ</button></div><div id="s4AiOut" class="s4-ai-out">پاسخ AI اینجا نمایش داده می‌شود.</div></div></div>`,{hideOk:true});
    document.querySelectorAll('[data-ai]').forEach(b=>b.onclick=async()=>{const p=$('s4AiPrompt').value.trim();if(!p)return showToast('متن را وارد کن',true);const mode=b.dataset.ai,task=mode==='summarize'?'این متن را خلاصه کن: ':mode==='translate'?'این متن را به فارسی ترجمه کن: ':mode==='rewrite'?'این متن را حرفه‌ای و روان بازنویسی کن: ':'';$('s4AiOut').textContent='در حال پردازش…';try{const r=await api('/api/ai/chat',{method:'POST',body:JSON.stringify({prompt:task+p})});$('s4AiOut').textContent=r.text||'پاسخی دریافت نشد.'}catch(e){$('s4AiOut').textContent=e.message}});
  }
  async function installPwa(){if(installPrompt){installPrompt.prompt();await installPrompt.userChoice.catch(()=>{});installPrompt=null;return}if(window.matchMedia('(display-mode: standalone)').matches)return showToast('زنتو همین حالا به‌صورت اپ اجرا می‌شود ✓');stage4Modal('📲 نصب زنتو',`<div class="s4-modal"><div class="s4-hero"><b>زنتو را نصب کن</b><small>از منوی مرورگر گزینه Install app / Add to Home Screen را انتخاب کن.</small></div><div class="feature-intro">اگر دکمه نصب مستقیم نمایش داده نشد، مرورگر باید ابتدا PWA را قابل نصب تشخیص دهد.</div></div>`,{hideOk:true})}

  async function toggleScreenShare(){
    if(!call?.pc)return showToast('تماس فعالی وجود ندارد',true);
    if(!call.video)return showToast('اشتراک صفحه فقط در تماس تصویری فعال است',true);
    if(call.screen){const cam=call.local?.getVideoTracks?.()[0];const sender=call.pc.getSenders().find(s=>s.track?.kind==='video');if(sender&&cam)await sender.replaceTrack(cam);call.screen.getTracks().forEach(t=>t.stop());call.screen=null;showToast('اشتراک صفحه متوقف شد');return}
    try{const stream=await navigator.mediaDevices.getDisplayMedia({video:true,audio:true});const track=stream.getVideoTracks()[0];const sender=call.pc.getSenders().find(s=>s.track?.kind==='video');if(sender)await sender.replaceTrack(track);else call.pc.addTrack(track,stream);call.screen=stream;track.onended=()=>toggleScreenShare();showToast('اشتراک صفحه فعال شد 🖥️')}catch(e){showToast('اشتراک صفحه لغو شد یا توسط مرورگر پشتیبانی نمی‌شود',true)}
  }
  const oldOpenCallUI4=openCallUI;
  openCallUI=function(other,video,incoming){oldOpenCallUI4(other,video,incoming);setTimeout(()=>{if(!$('screenShareCall')){$('screenShareCall')?.remove();const b=document.createElement('button');b.id='screenShareCall';b.type='button';b.textContent='🖥️';b.title='اشتراک صفحه';b.onclick=toggleScreenShare;$('cameraCall')?.parentElement?.insertBefore(b,$('acceptCall'))}},0)};

  const oldConnect4=connectSocket;
  connectSocket=function(){oldConnect4();if(!socket)return;socket.emit('device:hello',{deviceId});socket.on('device:state',d=>{const el=$('s4DeviceCount');if(el)el.textContent=(d.devices||1)+' نشست آنلاین';});socket.on('presence',d=>{if(current?.type==='direct'){const other=current.members.find(x=>Number(x.id)!==Number(me.id));if(other&&Number(d.userId)===Number(other.id))$('chatStatus').textContent=d.online?'🟢 آنلاین':'آخرین بازدید اخیر'}});socket.on('game:invite',g=>{if(!current||Number(current.id)!==Number(g.conversationId))return;showToast('یک بازی دوز در این گفتگو شروع شد 🎮');});socket.on('game:state',g=>{if(gameModalOpen&&current&&Number(current.id)===Number(g.conversationId)&&$('s4Board')){const board=$('s4Board');activeGame=g;board.innerHTML=g.board.map((v,i)=>`<button data-cell="${i}">${v||' '}</button>`).join('');const myTurn=g.players.length===2&&g.turn===Number(me.id)&&!g.winner;$('s4GameStatus').textContent=g.winner?(g.winner==='draw'?'مساوی شد 🎯':Number(g.winner)===Number(me.id)?'بردی! 🏆':'باختی 😄'):(g.players.length<2?'منتظر بازیکن دوم…':myTurn?'نوبت توست':'نوبت حریف است');board.querySelectorAll('[data-cell]').forEach(b=>b.onclick=()=>{if(myTurn&&!g.board[Number(b.dataset.cell)])socket.emit('game:move',{conversationId:g.conversationId,cell:Number(b.dataset.cell)})})}});socket.on('game:ended',()=>{activeGame=null;if($('s4GameStatus'))$('s4GameStatus').textContent='بازی پایان یافت'});};

  const oldLogout4=logout;logout=async()=>{activeGame=null;gameModalOpen=false;return oldLogout4()};
  addDrawer();setTimeout(addDrawer,900);
  function addSettingsQuickAccess(){const drawer=document.querySelector('.drawer');if(!drawer||document.getElementById('drawerSettingsQuick'))return;const b=document.createElement('button');b.id='drawerSettingsQuick';b.type='button';b.textContent='⚙️ تنظیمات';b.onclick=()=>{closeDrawer();openSettings()};drawer.appendChild(b)}
  setTimeout(addSettingsQuickAccess,100);setTimeout(addSettingsQuickAccess,1000);
  if('serviceWorker' in navigator)navigator.serviceWorker.register('/sw.js').catch(()=>{});
})();

// Runtime compatibility guards for cached/older deployments.
window.stage2HandleMessageHash=window.stage2HandleMessageHash||stage2HandleMessageHash;
window.selectedStage2Messages=window.selectedStage2Messages||selectedStage2Messages;
