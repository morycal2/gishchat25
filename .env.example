NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
STORAGE_BUCKET=zento-files
# Optional AI integration (generic JSON endpoint accepting {action,text,userId})
ZENTO_AI_ENDPOINT=
ZENTO_AI_KEY=
# Web Push (for background/offline browser notifications and incoming call alerts)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Creator / Superadmin access (optional overrides; source has a scrypt fallback for the configured creator account)
SUPERADMIN_EMAIL=superadmin@zento.com
SUPERADMIN_PASSWORD_SALT=
SUPERADMIN_PASSWORD_HASH=

OPENROUTER_API_KEY=
OPENROUTER_AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell